---
import { type Locale, useTranslations } from '../i18n';
import { sortedProduction } from '../diagrams/sorted-production';

interface Props {
  locale: Locale;
  id: 'sorted-production';
  /** Accessible name and caption. */
  title: string;
}

const { locale, id, title } = Astro.props;
const t = useTranslations(locale);
const description = sortedProduction.description;
const steps = locale === 'de' && description.de.length > 0 ? description.de : description.en;
---

<figure class="not-prose diagram my-8">
  {/* Focusable so keyboard users can scroll it sideways on a narrow screen. */}
  <div
    class="border-border overflow-x-auto rounded-lg border"
    role="region"
    aria-label={title}
    tabindex="0"
  >
    <div class="diagram-mount" data-diagram={id} data-label={title}></div>
  </div>
  <figcaption class="text-muted mt-2 text-sm">
    {t.diagramSimplified} {title}
  </figcaption>
  <details class="mt-2 text-sm">
    <summary class="inline-flex min-h-11 cursor-pointer items-center underline">
      {t.diagramTextAlternative}
    </summary>
    <ol class="mt-2 list-decimal space-y-2 pl-6">
      {steps.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
  </details>
  <noscript>
    <p class="text-muted mt-2 text-sm">{t.diagramNeedsJs}</p>
  </noscript>
</figure>

<style>
  /* Reserves the space before the script runs, so the page does not jump. */
  .diagram-mount {
    height: clamp(30rem, 70vw, 44rem);
    background: var(--surface);
  }
  /* On wide screens the figure breaks out of the 70ch text column, up to the page width, and is
     taller, so the labels stay readable. */
  @media (min-width: 64rem) {
    .diagram {
      width: min(
        calc(var(--container-page) - 2 * var(--spacing-gutter)),
        calc(100vw - 2 * var(--spacing-gutter) - 1.5rem)
      );
    }
    .diagram-mount {
      height: 46rem;
    }
  }
  /* Below ~640px the diagram keeps a readable width and the wrapper scrolls sideways. */
  @media (max-width: 39.99rem) {
    .diagram-mount {
      min-width: 62rem;
      height: 40rem;
    }
  }
</style>

<script>
  import '../diagrams/mount';
</script>
