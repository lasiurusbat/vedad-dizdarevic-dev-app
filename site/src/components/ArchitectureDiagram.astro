---
import { type Locale, useTranslations } from '../i18n';
import { sortedProduction } from '../diagrams/sorted-production';
import { sortedRelease } from '../diagrams/sorted-release';
import { rainalertRelease } from '../diagrams/rainalert-release';
import { sitePlatform } from '../diagrams/site-platform';

interface Props {
  locale: Locale;
  id: 'sorted-production' | 'sorted-release' | 'rainalert-release' | 'site-platform';
  /** Accessible name and caption. */
  title: string;
  /** A wide, flat diagram (two rows): a shorter canvas, so the fitted view has no empty bands. */
  compact?: boolean;
}

const { locale, id, title, compact = false } = Astro.props;
const t = useTranslations(locale);
const description = {
  'sorted-production': sortedProduction,
  'sorted-release': sortedRelease,
  'rainalert-release': rainalertRelease,
  'site-platform': sitePlatform,
}[id].description;
const definition = {
  'sorted-production': sortedProduction,
  'sorted-release': sortedRelease,
  'rainalert-release': rainalertRelease,
  'site-platform': sitePlatform,
}[id];
const steps = locale === 'de' && description.de.length > 0 ? description.de : description.en;
// Path buttons: hidden until the diagram mounts (FlowDiagram wires them), so no-JS visitors see
// none. "Everything" (no data-path value) clears the selection.
const paths = (definition.paths ?? []).map((p) => ({
  id: p.id,
  label: p.label[locale],
  summary: p.summary[locale],
}));
---

<figure class:list={['not-prose diagram my-8', compact && 'compact']}>
  {paths.length > 0 && (
    <div class="paths" role="group" aria-label={t.diagramPaths} data-paths hidden>
      <span class="paths-label text-muted text-sm" aria-hidden="true">
        {t.diagramPaths}
      </span>
      <div class="paths-buttons">
        <button type="button" data-path="" data-summary="" aria-pressed="true">
          {t.diagramPathAll}
        </button>
        {paths.map((p) => (
          <button type="button" data-path={p.id} data-summary={p.summary} aria-pressed="false">
            {p.label}
          </button>
        ))}
      </div>
    </div>
  )}
  {/* Focusable so keyboard users can scroll it sideways on a narrow screen. */}
  <div
    class="border-border overflow-x-auto rounded-lg border"
    role="region"
    aria-label={title}
    tabindex="0"
  >
    <div class="diagram-mount" data-diagram={id} data-label={title}></div>
  </div>
  {paths.length > 0 && <p class="path-status mt-3 text-sm" aria-live="polite" data-path-status />}
  <noscript>
    <p class="text-muted mt-2 text-sm">{t.diagramNeedsJs}</p>
  </noscript>
  <figcaption class="text-muted mt-2 text-sm">
    {t.diagramSimplified} {title}
    <details class="text-fg mt-2">
      <summary class="inline-flex min-h-11 cursor-pointer items-center underline">
        {t.diagramTextAlternative}
      </summary>
      <ol class="mt-2 list-decimal space-y-2 pl-6">
        {steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </details>
  </figcaption>
</figure>

<style>
  /* Reserves the space before the script runs, so the page does not jump. */
  .diagram-mount {
    height: clamp(30rem, 70vw, 44rem);
    background: var(--surface);
  }
  /* On wide screens the figure breaks out of the 70ch text column, up to the page width, and is
     taller, so the labels stay readable. */
  @media (min-width: 64rem) {
    .diagram {
      width: min(
        calc(var(--container-page) - 2 * var(--spacing-gutter)),
        calc(100vw - 2 * var(--spacing-gutter) - 1.5rem)
      );
    }
    .diagram-mount {
      height: 46rem;
    }
  }
  /* Below ~640px the diagram keeps a readable width and the wrapper scrolls sideways. */
  @media (max-width: 39.99rem) {
    .diagram-mount {
      min-width: 68rem;
      height: 40rem;
    }
  }
</style>

<style>
  /*
   * Path buttons: a segmented row above the canvas, on the secondary buttons' lit-from-above
   * surface. The pressed one takes the accent edge and glow; touch targets stay at 44px.
   */
  .paths {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }
  .paths[hidden] {
    display: none;
  }
  .paths-buttons {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }
  .paths button {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid transparent;
    border-radius: 9px;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition:
      color 150ms ease,
      border-color 150ms ease,
      box-shadow 150ms ease;
  }
  .paths button:hover {
    color: var(--fg);
  }
  .paths button[aria-pressed='true'] {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border-strong));
    background: linear-gradient(
      to bottom,
      light-dark(#ffffff, #1b1d2a),
      light-dark(#f3f4f8, #12131d)
    );
    box-shadow:
      inset 0 1px 0 0 light-dark(rgb(255 255 255 / 1), rgb(255 255 255 / 0.07)),
      0 0 14px 0 color-mix(in srgb, var(--accent) 25%, transparent);
    color: var(--fg);
  }
  .paths button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .path-status {
    max-width: var(--container-measure);
    color: var(--fg);
  }
  .path-status:empty {
    display: none;
  }

  /* Compact: the release path is about 3.5 times wider than tall. */
  .compact .diagram-mount {
    height: clamp(18rem, 32vw, 24rem);
  }
  @media (min-width: 64rem) {
    .compact .diagram-mount {
      height: 26rem;
    }
  }
  @media (max-width: 39.99rem) {
    .compact .diagram-mount {
      height: 20rem;
    }
  }
</style>

<script>
  import '../diagrams/mount';
</script>
