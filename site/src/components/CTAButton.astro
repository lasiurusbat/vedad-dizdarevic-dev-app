---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;

const base =
  'inline-flex min-h-11 items-center justify-center rounded-full px-5 py-2 font-medium no-underline transition-colors';
// Primary: the one gradient on the site (tokens in global.css), white text in both themes.
const variants = {
  primary:
    'bg-linear-353 from-fill-from to-fill-to text-white shadow-rim hover:from-fill-hover hover:to-fill-from',
  secondary: 'border border-border-strong text-fg hover:bg-surface',
};
---

<a href={href} class={`${base} ${variants[variant]}`}>
  <slot />
</a>
