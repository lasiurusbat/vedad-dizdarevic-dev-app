---
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  summary: string;
  href: string;
  tags?: string[];
}

const { locale, title, summary, href, tags = [] } = Astro.props;
const t = useTranslations(locale);
---

<!-- The whole card is clickable through the title link (stretched ::after), one link per card. -->
<article class="not-prose border-border bg-surface focus-within:border-accent hover:border-border-strong relative flex flex-col gap-3 rounded-lg border p-6">
  <h3 class="text-xl font-semibold">
    <a href={href} class="no-underline after:absolute after:inset-0 after:content-['']">
      {title}
    </a>
  </h3>
  <p class="text-muted">{summary}</p>
  {tags.length > 0 && (
    <ul class="flex flex-wrap gap-2" role="list">
      {tags.map((tag) => (
        <li class="border-border text-muted rounded-md border px-2 py-0.5 text-xs">{tag}</li>
      ))}
    </ul>
  )}
  <p class="text-accent mt-auto pt-2 text-sm font-medium" aria-hidden="true">
    {t.readCaseStudy} →
  </p>
</article>
