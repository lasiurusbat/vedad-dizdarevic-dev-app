---
import { type Locale, useTranslations } from '../i18n';
import type { CaseStudy } from '../lib/caseStudies';

interface Props {
  locale: Locale;
  data: CaseStudy['data'];
}

const { locale, data } = Astro.props;
const t = useTranslations(locale);
// Live links (the running product) become badges; the domain shows where the link goes.
const liveLinks = data.liveLinks.map((l) => ({ ...l, host: new URL(l.url).hostname }));
// The source cell closes the fact row: the repository name as a link, or a plain note if private.
const source = data.repoUrl
  ? { value: data.repoUrl.replace(/\/+$/, '').split('/').pop() ?? data.repoUrl, url: data.repoUrl }
  : data.repoPrivate
    ? { value: t.casePrivateRepo }
    : undefined;
const cells: { label: string; value: string; url?: string }[] = [
  ...data.facts,
  ...(source ? [{ label: t.caseRepo, ...source }] : []),
];
---

<!--
  The structured part of a case study, before the MDX body. Order: the fact sheet (what, who, when,
  where; the status line carries the live link), then the outcome stats and their honesty note, so the evidence comes
  before the reasoning; then the problem. The decisions follow in the MDX body, each as its own
  section with a TradeOff note. Headings start at h2.
-->
{(liveLinks.length > 0 || cells.length > 0) && (
  <div class="facts not-prose">
    {liveLinks.length > 0 && (
      <p class="status">
        <span class="sr-only">{t.caseStatus}:</span>
        <span class="live-dot" aria-hidden="true"></span>
        <span class="status-text">{data.status ?? t.caseLive}</span>
        {liveLinks.map((l) => (
          <a href={l.url} target="_blank" rel="noopener noreferrer" class="status-link">
            {l.host}
            <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false">
              <path d="M4 2.5h5.5V8 M9.5 2.5 3 9" />
            </svg>
            <span class="sr-only">{t.opensNewTab}</span>
          </a>
        ))}
      </p>
    )}
    {cells.length > 0 && (
      <dl class="fact-row">
        {cells.map((c) => (
          <div class="fact">
            <dt class="text-muted">{c.label}</dt>
            <dd>
              {c.url ? (
                <a href={c.url} rel="noopener noreferrer" class="underline">
                  {c.value}
                </a>
              ) : (
                c.value
              )}
            </dd>
          </div>
        ))}
      </dl>
    )}
  </div>
)}

{data.outcomes.length > 0 && (
  <section aria-labelledby="case-outcome" class="not-prose outcome">
    {/* The stats speak for themselves under the hero; the heading is for screen readers. */}
    <h2 id="case-outcome" class="sr-only">
      {t.caseOutcome}
    </h2>
    {/* One panel of large stats separated by hairlines; the value reads first, the label explains. */}
    <dl class="stats card border-border rounded-lg border">
      {data.outcomes.map((o) => (
        <div class="stat">
          <dt class="text-muted text-sm">{o.label}</dt>
          <dd class="font-display">{o.value}</dd>
        </div>
      ))}
    </dl>
    {data.outcomesNote && <p class="text-muted max-w-measure mt-3 text-sm">{data.outcomesNote}</p>}
  </section>
)}

<h2>{t.caseProblem}</h2>
<p>{data.problem}</p>

<style>
  /*
   * Fact sheet: a status line (live dot, status, the product's domain as the link), then one row
   * of short facts, label above value. Small text on hairlines and no card, so it stays quieter
   * than the stats panel below it: this answers "what is it", the stats "what came of it".
   * Two columns on phones, one line from tablet width up.
   */
  .facts {
    --live: light-dark(#2f7d55, #6cc795);

    margin-bottom: 2rem;
    font-size: var(--text-sm);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    min-height: 2.75rem;
    padding-bottom: 0.5rem;
  }

  .status-text {
    margin-left: 0.125rem;
    color: var(--fg);
    font-weight: 500;
  }

  /* The domain sits at the end of the line, muted until hovered; the arrow says it leaves. */
  .status-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.25em;
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }

  .status-link:hover {
    color: var(--fg);
    text-decoration-color: currentColor;
  }

  .status-link svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fact-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    padding: 0.875rem 0;
    border-block: 1px solid var(--border);
  }

  /* From tablet width the facts share one line, each as wide as its value, spread edge to edge
     so the row ends where the stats panel below ends. */
  @media (min-width: 48rem) {
    .fact-row {
      display: flex;
      justify-content: space-between;
      gap: 2rem;
    }

    /* Cells shrink and wrap only when the row would not fit (long repository names). */
    .fact {
      min-width: 0;
      flex: 0 1 auto;
    }
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .fact dd {
    color: var(--fg);
  }

  .live-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 6px var(--live);
  }

  /* One slow ripple every few seconds: alive, not busy. */
  .live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--live);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .live-dot::after {
      animation: ripple 3.2s ease-out infinite;
    }
  }

  @keyframes ripple {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    45%,
    100% {
      opacity: 0;
      transform: scale(3);
    }
  }

  .outcome {
    margin-bottom: 2.5rem;
  }

  /* Two columns on phones, four on wide screens; hairlines between cells, no boxes. */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.375rem;
    padding: 1.25rem;
  }

  /* Hairlines: between columns, and between rows on phones. */
  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  @media (max-width: 47.99rem) {
    .stat:nth-child(odd) {
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  .stat dd {
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
</style>
