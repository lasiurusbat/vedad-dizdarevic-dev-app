---
import { type Locale, useTranslations } from '../i18n';
import type { CaseStudy } from '../lib/caseStudies';

interface Props {
  locale: Locale;
  data: CaseStudy['data'];
}

const { locale, data } = Astro.props;
const t = useTranslations(locale);
const links = [
  ...(data.repoUrl ? [{ label: t.caseRepo, url: data.repoUrl }] : []),
  ...data.liveLinks,
];
---

<!-- The structured part of a case study; the MDX body follows it. Headings start at h2. -->
<h2>{t.caseProblem}</h2>
<p>{data.problem}</p>

<h2>{t.caseDecisions}</h2>
<ol>
  {data.decisions.map((d) => (
    <li>
      <strong>{d.decision}</strong>
      <br />
      <span class="text-muted">
        {t.caseWhy}: {d.why}
      </span>
    </li>
  ))}
</ol>

{data.outcomes.length > 0 && (
  <>
    <h2>{t.caseOutcome}</h2>
    <dl class="not-prose my-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {data.outcomes.map((o) => (
        <div class="card border-border rounded-lg border p-4">
          <dt class="text-muted text-sm">{o.label}</dt>
          <dd class="mt-1 text-2xl font-medium">{o.value}</dd>
        </div>
      ))}
    </dl>
  </>
)}

{(links.length > 0 || data.repoPrivate) && (
  <>
    <h2>{t.caseLinks}</h2>
    <ul>
      {data.repoPrivate && <li>{t.casePrivateRepo}</li>}
      {links.map((l) => (
        <li>
          <a href={l.url} rel="noopener noreferrer">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </>
)}
