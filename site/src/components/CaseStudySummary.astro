---
import { type Locale, useTranslations } from '../i18n';
import type { CaseStudy } from '../lib/caseStudies';
import CostComparison from './CostComparison.astro';

interface Props {
  locale: Locale;
  data: CaseStudy['data'];
}

const { locale, data } = Astro.props;
const t = useTranslations(locale);
const links = [
  ...(data.repoUrl ? [{ label: t.caseRepo, url: data.repoUrl }] : []),
  ...data.liveLinks,
];
---

<!-- The structured part of a case study; the MDX body follows it. Headings start at h2. -->
<!-- Links sit first, next to the title, so they do not break the flow between outcome and write-up. -->
{(links.length > 0 || data.repoPrivate) && (
  <ul class="case-links not-prose text-sm" role="list">
    {links.map((l) => (
      <li>
        <a href={l.url} rel="noopener noreferrer" class="underline">
          {l.label}
        </a>
      </li>
    ))}
    {data.repoPrivate && <li class="text-muted">{t.casePrivateRepo}</li>}
  </ul>
)}

<h2>{t.caseProblem}</h2>
<p>{data.problem}</p>

<h2>{t.caseDecisions}</h2>
<ol>
  {data.decisions.map((d) => (
    <li>
      <strong>{d.decision}</strong>
      <br />
      <span class="text-muted">
        {t.caseWhy}: {d.why}
      </span>
    </li>
  ))}
</ol>

{data.outcomes.length > 0 && (
  <>
    <h2>{t.caseOutcome}</h2>
    {/* One panel of large stats separated by hairlines; the value reads first, the label explains. */}
    <dl class="not-prose stats card border-border my-6 rounded-lg border">
      {data.outcomes.map((o) => (
        <div class="stat">
          <dt class="text-muted text-sm">{o.label}</dt>
          <dd class="font-display">{o.value}</dd>
        </div>
      ))}
    </dl>
    {data.costs && <CostComparison costs={data.costs} />}
  </>
)}

<style>
  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-bottom: 2rem;
  }
  .case-links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }
  .case-links li {
    display: flex;
    align-items: center;
  }
  /* Two columns on phones, four on wide screens; hairlines between cells, no boxes. */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.375rem;
    padding: 1.25rem;
  }

  /* Hairlines: between columns, and between rows on phones. */
  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  @media (max-width: 47.99rem) {
    .stat:nth-child(odd) {
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  .stat dd {
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
</style>
