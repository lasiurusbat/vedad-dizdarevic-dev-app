---
import { type Locale, useTranslations } from '../i18n';
import type { CaseStudy } from '../lib/caseStudies';

interface Props {
  locale: Locale;
  data: CaseStudy['data'];
}

const { locale, data } = Astro.props;
const t = useTranslations(locale);
// Live links (the running product) become badges; the domain shows where the link goes.
const liveLinks = data.liveLinks.map((l) => ({ ...l, host: new URL(l.url).hostname }));
// The source row closes the fact sheet: a link for a public repository, a plain note otherwise.
const repoText = data.repoUrl ? data.repoUrl.replace(/^https?:\/\//, '') : undefined;
const hasSource = Boolean(data.repoUrl) || data.repoPrivate;
---

<!--
  The structured part of a case study, before the MDX body. Order: the fact sheet (what, who, when,
  where, with the live link), then the outcome stats and their honesty note, so the evidence comes
  before the reasoning; then the problem and the decisions. Headings start at h2.
-->
{(data.facts.length > 0 || hasSource || liveLinks.length > 0) && (
  <div class="facts-block not-prose">
    {(data.facts.length > 0 || hasSource) && (
      <dl class="facts text-sm">
        {data.facts.map((f) => (
          <div class="fact">
            <dt class="text-muted">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
        {hasSource && (
          <div class="fact">
            <dt class="text-muted">{t.caseRepo}</dt>
            <dd>
              {data.repoUrl ? (
                <a href={data.repoUrl} rel="noopener noreferrer" class="underline">
                  {repoText}
                </a>
              ) : (
                t.casePrivateRepo
              )}
            </dd>
          </div>
        )}
      </dl>
    )}
    {liveLinks.length > 0 && (
      <ul class="case-links text-sm" role="list">
        {liveLinks.map((l) => (
          <li>
            {/* A status chip that is also the link: the dot says the product is live. */}
            <a href={l.url} target="_blank" rel="noopener noreferrer" class="live-badge">
              <span class="live-dot" aria-hidden="true"></span>
              <span class="live-label">{l.label}</span>
              <span class="live-host">
                {l.host}
                <svg
                  viewBox="0 0 12 12"
                  width="12"
                  height="12"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M4 2.5h5.5V8 M9.5 2.5 3 9" />
                </svg>
              </span>
              <span class="sr-only">{t.opensNewTab}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
)}

{data.outcomes.length > 0 && (
  <section aria-labelledby="case-outcome" class="not-prose outcome">
    {/* The stats speak for themselves under the hero; the heading is for screen readers. */}
    <h2 id="case-outcome" class="sr-only">
      {t.caseOutcome}
    </h2>
    {/* One panel of large stats separated by hairlines; the value reads first, the label explains. */}
    <dl class="stats card border-border rounded-lg border">
      {data.outcomes.map((o) => (
        <div class="stat">
          <dt class="text-muted text-sm">{o.label}</dt>
          <dd class="font-display">{o.value}</dd>
        </div>
      ))}
    </dl>
    {data.outcomesNote && <p class="text-muted max-w-measure mt-3 text-sm">{data.outcomesNote}</p>}
  </section>
)}

<h2>{t.caseProblem}</h2>
<p>{data.problem}</p>

<h2>{t.caseDecisions}</h2>
<ol>
  {data.decisions.map((d) => (
    <li>
      <strong>{d.decision}</strong>
      <br />
      <span class="text-muted">
        {t.caseWhy}: {d.why}
      </span>
    </li>
  ))}
</ol>

<style>
  /*
   * Fact sheet: a key/value list on hairlines, label left and value right from 30rem up, stacked
   * on narrow phones. Quieter than the stats below it (small text, no card): it answers "what is
   * this", the stats answer "what came of it". The live badge sits under it.
   */
  .facts-block {
    max-width: var(--container-measure);
    margin-bottom: 2rem;
  }

  .facts {
    border-top: 1px solid var(--border);
  }

  .fact {
    display: grid;
    gap: 0.125rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 30rem) {
    .fact {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 1rem;
    }
  }

  .fact dd a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin: -0.75rem 0;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
  }

  .outcome {
    margin-bottom: 2.5rem;
  }

  /*
   * Live badge: a pill (set apart from the 10px action buttons: it goes to the product, it is not
   * a call to contact) on the secondary buttons' lit-from-above surface. The status dot is the one
   * extra colour, a muted green that means "online". The domain is the second segment so the
   * reader knows where the link leads; the arrow marks that it leaves this site. It opens in a new
   * tab (announced to screen readers), so the case study stays open.
   */
  .live-badge {
    --badge-top: light-dark(#ffffff, #1b1d2a);
    --badge-bottom: light-dark(#f3f4f8, #12131d);
    --badge-edge: light-dark(#cfd3de, #2b3042);
    --badge-shine: light-dark(rgb(255 255 255 / 1), rgb(255 255 255 / 0.07));
    --badge-halo: light-dark(rgb(56 100 116 / 0.12), rgb(166 181 190 / 0.14));
    --live: light-dark(#2f7d55, #6cc795);

    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.625rem;
    padding: 0 0.5rem 0 1rem;
    border: 1px solid var(--badge-edge);
    border-radius: 999px;
    background: linear-gradient(to bottom, var(--badge-top), var(--badge-bottom));
    box-shadow:
      inset 0 1px 0 0 var(--badge-shine),
      0 0 14px 0 var(--badge-halo);
    color: var(--fg);
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .live-badge:hover {
    --badge-edge: light-dark(#83909a, #4f8597);
    --badge-halo: light-dark(rgb(56 100 116 / 0.22), rgb(143 180 195 / 0.3));
  }

  .live-badge:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .live-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 6px var(--live);
  }

  /* One slow ripple every few seconds: alive, not busy. */
  .live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--live);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .live-dot::after {
      animation: ripple 3.2s ease-out infinite;
    }
  }

  @keyframes ripple {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    45%,
    100% {
      opacity: 0;
      transform: scale(3);
    }
  }

  /* The domain segment: a hairline before it, muted until hovered. */
  .live-host {
    display: inline-flex;
    min-height: 1.875rem;
    align-items: center;
    gap: 0.375rem;
    padding: 0 0.75rem 0 0.625rem;
    border-left: 1px solid var(--badge-edge);
    color: var(--muted);
    font-weight: 400;
    transition: color 150ms ease;
  }

  .live-badge:hover .live-host {
    color: var(--fg);
  }

  .live-host svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .case-links li {
    display: flex;
    align-items: center;
  }
  /* Two columns on phones, four on wide screens; hairlines between cells, no boxes. */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.375rem;
    padding: 1.25rem;
  }

  /* Hairlines: between columns, and between rows on phones. */
  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  @media (max-width: 47.99rem) {
    .stat:nth-child(odd) {
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  .stat dd {
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
</style>
