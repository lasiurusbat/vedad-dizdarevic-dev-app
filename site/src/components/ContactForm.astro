---
/*
 * The contact form. Posts JSON to /api/contact; the Worker checks Turnstile, the Lambda sends.
 *
 * Needs JavaScript, because Turnstile does: the form stays hidden without it, and the email address
 * beside it always works. Turnstile (a third party) loads only once someone starts on the form, so
 * reading the page contacts nobody else. CSP: no inline styles or scripts; state is `hidden`,
 * attributes and classes. Limits and the email pattern come from @vdd/contact-schema; the Lambda
 * applies the same ones and has the last word.
 */
import { EMAIL_MAX, MESSAGE_MAX, NAME_MAX } from '@vdd/contact-schema';
import { type Locale, localeUrl, useTranslations } from '../i18n';
import { CONTACT_EMAIL, TURNSTILE_SITE_KEY } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="contact not-prose">
  <div class="intro">
    <p class="max-w-measure text-lg">{t.contactIntro}</p>
    <p class="text-muted mt-4">
      {t.contactDirect}{' '}
      <a class="direct underline" href={`mailto:${CONTACT_EMAIL}`}>
        {CONTACT_EMAIL}
      </a>
    </p>
    <noscript>
      <p class="text-muted mt-4">{t.contactNoScript}</p>
    </noscript>
  </div>

  <form
    class="form card border-border rounded-lg border"
    novalidate
    hidden
    data-contact
    data-sitekey={TURNSTILE_SITE_KEY}
    data-language={locale}
    data-sending={t.contactSending}
    data-success={t.contactSuccess}
    data-error-verification={t.contactErrorVerification}
    data-error-invalid={t.contactErrorInvalid}
    data-error-failed={t.contactErrorFailed}
  >
    <fieldset class="field">
      <legend class="label">{t.contactTypeLabel}</legend>
      <div class="types">
        {t.contactTypes.map((type, i) => (
          <label class="type">
            <input type="radio" name="type" value={type.value} checked={i === 0} />
            <span>{type.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="field">
      <label class="label" for="contact-name">
        {t.contactName}
      </label>
      <input
        class="input"
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        maxlength={NAME_MAX}
        required
        aria-describedby="contact-name-error"
      />
      <p class="error" id="contact-name-error" hidden>
        {t.contactErrorName}
      </p>
    </div>

    <div class="field">
      <label class="label" for="contact-email">
        {t.contactEmail}
      </label>
      <input
        class="input"
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        maxlength={EMAIL_MAX}
        required
        aria-describedby="contact-email-error"
      />
      <p class="error" id="contact-email-error" hidden>
        {t.contactErrorEmail}
      </p>
    </div>

    <div class="field">
      <label class="label" for="contact-message">
        {t.contactMessage}
      </label>
      <textarea
        class="input"
        id="contact-message"
        name="message"
        rows="6"
        maxlength={MESSAGE_MAX}
        required
        aria-describedby="contact-message-error"
      ></textarea>
      <p class="error" id="contact-message-error" hidden>
        {t.contactErrorMessage}
      </p>
    </div>

    {/* The honeypot: off-screen for people and skipped by the keyboard, tempting for bots. */}
    <div class="trap" aria-hidden="true">
      <label>
        Website
        <input name="website" type="text" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="widget" data-widget></div>

    <div class="actions">
      <button class="btn-send" type="submit" data-submit>
        {t.contactSend}
      </button>
      <p class="status" role="status" tabindex="-1" hidden data-status></p>
    </div>

    <p class="text-muted text-sm">
      {t.contactPrivacy}{' '}
      <a class="underline" href={localeUrl(locale, 'datenschutz/')}>
        {t.contactPrivacyLink}
      </a>
    </p>
  </form>
</div>

<style>
  .contact {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 3rem;
      align-items: start;
    }
  }

  /* Moves to the next line whole, not split at its hyphen; breaks only if wider than the column. */
  .direct {
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .form[hidden] {
    display: none;
  }

  @media (min-width: 48rem) {
    .form {
      padding: 2rem;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
    border: 0;
  }

  .label {
    padding: 0;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.625rem;
    background: var(--bg);
    color: var(--fg);
  }

  textarea.input {
    display: block;
    min-height: 9rem;
    resize: vertical;
  }

  .input[aria-invalid='true'] {
    border-color: var(--error);
  }

  .error {
    color: var(--error);
    font-size: var(--text-sm);
  }

  .form {
    --error: light-dark(#a3282c, #f0a5a7);
    --ok: light-dark(#2a6f4b, #7fd3a5);
  }

  .types {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.125rem;
  }

  /* Radio buttons shown as pills; the input stays real, so keyboards and screen readers just work. */
  .type {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.875rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.625rem;
    cursor: pointer;
    font-size: var(--text-sm);
  }

  .type:has(input:checked) {
    border-color: var(--accent);
    background: var(--surface);
  }

  .type input {
    accent-color: var(--accent);
  }

  .trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Empty until Turnstile needs a person to do something. */
  .widget:empty {
    display: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  /* Same finish as the primary CTAButton, which is a link and cannot be a submit button. */
  .btn-send {
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid light-dark(#2c5260, #4f8597);
    border-radius: 0.625rem;
    background: linear-gradient(
      to bottom,
      light-dark(#467787, #22414d),
      light-dark(#376272, #172e37)
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 0 12px color-mix(in srgb, var(--accent) 30%, transparent);
    color: #fff;
    cursor: pointer;
    font-weight: 500;
  }

  .btn-send:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .status {
    flex: 1 1 14rem;
    font-size: var(--text-sm);
  }

  .status.is-ok {
    color: var(--ok);
    font-weight: 500;
  }

  .status.is-error {
    color: var(--error);
  }
</style>

<script>
  import { initContactForm } from '../scripts/contact-form';

  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) initContactForm(form);
</script>
