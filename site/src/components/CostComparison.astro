---
/*
 * Monthly cost comparison for a case study (frontmatter `costs`), styled as a comparison card:
 * one column per environment with its total and a bar on a shared scale, then the itemised table,
 * each cell with a thin data bar, and a fine-print footnote saying where the estimates come from.
 *
 * Colour has one job: the emphasised column (the outcome the chart is about) gets the accent;
 * every other bar is neutral. Bar lengths are SVG geometry (rect width in a 0-100 viewBox), not
 * style attributes, so the CSP stays `style-src 'self'`. The table is a real <table> with a
 * caption, header cells and a totals row; the bars are aria-hidden, the numbers carry the data.
 */
import type { CaseStudy } from '../lib/caseStudies';
import { getLocale, useTranslations } from '../i18n';

interface Props {
  costs: NonNullable<CaseStudy['data']['costs']>;
}

const { costs } = Astro.props;
const t = useTranslations(getLocale(Astro.currentLocale));
const { columns, rows, currency } = costs;

const maxTotal = Math.max(...columns.map((c) => c.total));
const maxCell = Math.max(...rows.flatMap((r) => r.values.filter((v): v is number => v !== null)));
const pct = (v: number, max: number) => Math.max(0, Math.min(100, (v / max) * 100));
const money = (v: number) => `${currency}${v}`;
const approx = (v: number) => `~${currency}${v}`;
---

<figure class="not-prose cost card border-border my-6 rounded-lg border">
  <figcaption class="head">
    <span class="font-display text-lg font-medium">{costs.title}</span>
    {costs.highlight && <span class="chip">{costs.highlight}</span>}
  </figcaption>

  <!-- Totals on one scale: the comparison at a glance. -->
  <ul class="totals" role="list">
    {columns.map((c) => (
      <li class:list={['total', c.emphasis && 'is-emphasis']}>
        <span class="text-muted text-sm">{c.label}</span>
        <span class="value font-display">{approx(c.total)}</span>
        <svg class="bar" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
          <rect class="track" width="100" height="6" rx="3" />
          <rect class="fill" width={pct(c.total, maxTotal)} height="6" rx="3" />
        </svg>
      </li>
    ))}
  </ul>

  <div class="table-wrap">
    <table>
      <caption class="sr-only">{costs.title}</caption>
      <thead>
        <tr>
          <th scope="col">{costs.itemHeader}</th>
          {columns.map((c) => (
            <th scope="col" class:list={['num', c.emphasis && 'is-emphasis']}>
              {c.label}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{r.item}</th>
            {r.values.map((v, i) => (
              <td class:list={['num', columns[i]?.emphasis && 'is-emphasis', v === 0 && 'is-zero']}>
                {v === null ? <span class="text-muted">–</span> : money(v)}
                {v !== null && v > 0 && (
                  <svg
                    class="cell-bar"
                    viewBox="0 0 100 3"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    <rect
                      class="fill"
                      x={100 - pct(v, maxCell)}
                      width={pct(v, maxCell)}
                      height="3"
                      rx="1.5"
                    />
                  </svg>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <th scope="row">{t.costTotal}</th>
          {columns.map((c) => (
            <td class:list={['num', c.emphasis && 'is-emphasis']}>{approx(c.total)}</td>
          ))}
        </tr>
      </tfoot>
    </table>
  </div>

  <p class="foot">{costs.footnote}</p>
</figure>

<style>
  .cost {
    padding: 1.25rem;
  }

  @media (min-width: 40rem) {
    .cost {
      padding: 1.5rem;
    }
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .chip {
    padding: 0.125rem 0.625rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 9999px;
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .totals {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .total {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .value {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    font-weight: 500;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .is-emphasis .value {
    color: var(--accent);
  }

  .bar {
    display: block;
    width: 100%;
    height: 6px;
    margin-top: 0.375rem;
  }

  .bar .track {
    fill: var(--border);
  }

  .bar .fill,
  .cell-bar .fill {
    fill: var(--border-strong);
  }

  .is-emphasis .bar .fill,
  .is-emphasis .cell-bar .fill {
    fill: var(--accent);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    margin-top: 0.5rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: 0.625rem 0.5rem;
    text-align: left;
    vertical-align: top;
  }

  th:first-child {
    padding-left: 0;
  }

  thead th {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  tbody th {
    font-weight: 400;
  }

  tbody tr + tr th,
  tbody tr + tr td {
    border-top: 1px solid var(--border);
  }

  .num {
    width: 24%;
    text-align: right;
  }

  thead th.is-emphasis,
  td.is-emphasis {
    color: var(--accent);
  }

  .is-zero {
    color: var(--muted);
  }

  .cell-bar {
    display: block;
    width: 100%;
    height: 3px;
    margin-top: 0.375rem;
  }

  tfoot th,
  tfoot td {
    border-top: 1px solid var(--border-strong);
    font-weight: 500;
  }

  .foot {
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.6;
  }
</style>
