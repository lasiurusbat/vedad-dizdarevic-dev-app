---
import { credentials } from '../data/credentials';
import { type Locale, useTranslations } from '../i18n';
import { Image } from 'astro:assets';
import ExternalLink from './ExternalLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const month = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<div class="not-prose">
  <h3 class="text-xl">{t.certsTitle}</h3>
  <ul class="mt-3 grid gap-3 md:grid-cols-3" role="list">
    {credentials.map((c) => (
      <li class="card border-border flex flex-col gap-1 rounded-lg border p-4">
        {c.badge && <Image src={c.badge} alt="" width={96} class="mb-2 h-auto w-24" />}
        <p class="font-medium">{c.title}</p>
        <p class="text-muted text-sm">{c.issuer}</p>
        <p class="text-muted text-sm">
          {c.status === 'in-progress' ? t.certInProgress : month.format(new Date(c.issued!))}
        </p>
        {c.verifyUrl && (
          <ExternalLink
            href={c.verifyUrl}
            class="mt-1 inline-flex min-h-11 items-center text-sm underline"
          >
            {t.certVerify}
            <span class="sr-only"> {c.title}</span>
          </ExternalLink>
        )}
      </li>
    ))}
  </ul>
</div>
