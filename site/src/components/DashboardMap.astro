---
/*
 * A Grafana dashboard drawn as a map of its panels: the dashboard's own order, grouped by the layer
 * each panel watches, with the metric behind it. No values on purpose: a live number or a traffic
 * curve on a portfolio page would read as a claim about users. Each tile has a small glyph for the
 * panel type (stat, time series, gauge, alert list), drawn with SVG attributes only, so the CSP
 * stays `style-src 'self'`. Text in `backticks` renders as inline code.
 */
interface Panel {
  title: string;
  viz: 'stat' | 'timeseries' | 'bars' | 'gauge' | 'alerts';
  /** Where the number comes from, e.g. '`HealthyHostCount`, minimum, 1 min'. */
  source: string;
}

interface Props {
  title: string;
  /** One line under the title: data source, refresh, time range. */
  meta: string;
  groups: { name: string; panels: Panel[] }[];
  footnote: string;
}

const { title, meta, groups, footnote } = Astro.props;

const parts = (s: string) =>
  s
    .split(/(`[^`]+`)/)
    .map((p) =>
      p.startsWith('`') && p.endsWith('`')
        ? { code: true, text: p.slice(1, -1) }
        : { code: false, text: p },
    );
---

<figure class="not-prose dash card border-border my-6 rounded-lg border">
  <figcaption class="head">
    <span class="font-display text-lg font-medium">{title}</span>
    <span class="text-muted text-sm">{meta}</span>
  </figcaption>

  {groups.map((g) => (
    <section class="group" aria-label={g.name}>
      <h3 class="group-name">{g.name}</h3>
      <ul class="panels" role="list">
        {g.panels.map((p) => (
          <li class="panel">
            <svg class="glyph" viewBox="0 0 48 20" aria-hidden="true">
              {p.viz === 'stat' && (
                <>
                  <rect x="2" y="4" width="16" height="12" rx="2" class="fill" />
                  <path d="M22 16 L30 12 L36 13 L46 6" class="line" />
                </>
              )}
              {p.viz === 'timeseries' && (
                <path d="M2 15 L10 11 L18 13 L26 6 L34 9 L46 4" class="line" />
              )}
              {p.viz === 'bars' && (
                <>
                  <rect x="3" y="11" width="5" height="7" class="fill" />
                  <rect x="12" y="7" width="5" height="11" class="fill" />
                  <rect x="21" y="12" width="5" height="6" class="fill" />
                  <rect x="30" y="4" width="5" height="14" class="fill" />
                  <rect x="39" y="9" width="5" height="9" class="fill" />
                </>
              )}
              {p.viz === 'gauge' && (
                <>
                  <rect x="2" y="8" width="44" height="5" rx="2.5" class="track" />
                  <rect x="2" y="8" width="34" height="5" rx="2.5" class="fill" />
                </>
              )}
              {p.viz === 'alerts' && (
                <>
                  <circle cx="5" cy="5" r="2.5" class="fill" />
                  <rect x="11" y="3.5" width="34" height="3" rx="1.5" class="track" />
                  <circle cx="5" cy="14" r="2.5" class="fill" />
                  <rect x="11" y="12.5" width="26" height="3" rx="1.5" class="track" />
                </>
              )}
            </svg>
            <span class="panel-title">{p.title}</span>
            <span class="panel-source">
              {parts(p.source).map((s) => (s.code ? <code>{s.text}</code> : s.text))}
            </span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p class="foot">{footnote}</p>
</figure>

<style>
  .dash {
    padding: 1.25rem;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .group {
    margin-top: 1.25rem;
  }

  .group-name {
    margin-bottom: 0.5rem;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .panels {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }

  .panel {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: center;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .glyph {
    grid-row: span 2;
    width: 3rem;
    height: 1.25rem;
  }

  .glyph .line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .glyph .fill {
    fill: color-mix(in srgb, var(--accent) 70%, transparent);
  }

  .glyph .track {
    fill: var(--border-strong);
  }

  .panel-title {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .panel-source {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    color: var(--fg);
  }

  .foot {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  @media (min-width: 40rem) {
    .dash {
      padding: 1.5rem;
    }

    .panels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Wide screens: page width, three columns, like the dashboard's own grid. */
  @media (min-width: 64rem) {
    .dash {
      width: min(
        calc(var(--container-page) - 2 * var(--spacing-gutter)),
        calc(100vw - 2 * var(--spacing-gutter) - 1.5rem)
      );
    }

    .panels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
