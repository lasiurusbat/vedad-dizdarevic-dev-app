---
import { type Locale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
  /** URL of the SVG (or image). Served as <img>, so it needs no inline styles or scripts. */
  src: string;
  /** Text alternative describing what the diagram shows. Required. */
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}

const { locale, src, alt, caption, width, height } = Astro.props;
const t = useTranslations(locale);
---

<figure class="not-prose my-8">
  <div class="border-border bg-surface rounded-lg border p-2">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
      class="h-auto w-full"
    />
  </div>
  <figcaption class="text-muted mt-2 flex flex-wrap items-baseline justify-between gap-x-4 text-sm">
    <span>{caption}</span>
    <a href={src} class="inline-flex min-h-11 items-center underline">
      {t.viewFullSize}
    </a>
  </figcaption>
</figure>
