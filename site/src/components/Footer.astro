---
import { GITHUB_URL, LINKEDIN_URL, OWNER } from '../site';
import { type Locale, localeUrl, useTranslations } from '../i18n';
import { caseStudyPath } from '../lib/caseStudies';
import ExternalLink from './ExternalLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="border-border border-t py-10">
  <div class="max-w-page px-gutter text-muted mx-auto flex flex-col gap-4 text-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {OWNER}. {t.footerRights}
      </p>
      <nav aria-label={t.footerNav} class="flex flex-wrap gap-x-4">
        <a
          href={caseStudyPath(locale, 'this-site')}
          class="text-fg inline-flex min-h-11 items-center underline"
        >
          {t.footerHowBuilt}
        </a>
        <a
          href={localeUrl(locale, 'datenschutz/')}
          class="text-fg inline-flex min-h-11 items-center underline"
        >
          {t.footerPrivacy}
        </a>
        <ExternalLink href={GITHUB_URL} class="text-fg inline-flex min-h-11 items-center underline">
          {t.github}
        </ExternalLink>
        <ExternalLink
          href={LINKEDIN_URL}
          class="text-fg inline-flex min-h-11 items-center underline"
        >
          {t.linkedin}
        </ExternalLink>
      </nav>
    </div>
    <p class="text-xs">{t.footerTrademarks}</p>
  </div>
</footer>
