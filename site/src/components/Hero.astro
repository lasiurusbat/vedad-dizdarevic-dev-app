---
import { CV_URL, GITHUB_URL, LINKEDIN_URL } from '../site';
import { type Locale, localeUrl, useTranslations } from '../i18n';
import CTAButton from './CTAButton.astro';
import HeroArchitecture from './HeroArchitecture.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section aria-labelledby="hero-title" class="py-section relative isolate overflow-x-clip">
  <!-- Light shaft: starts behind the navbar and drops down behind the diagram. Decorative. -->
  <div class="shaft" aria-hidden="true"></div>
  <div class="max-w-page px-gutter mx-auto grid items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
    <div class="flex flex-col items-start gap-stack">
      <p class="border-border bg-surface inline-flex items-center gap-2 rounded-full border px-3 py-1 text-sm">
        <span aria-hidden="true" class="status-dot bg-accent size-2 rounded-full"></span>
        {t.availability}
      </p>
      <!-- Reads as one two-line headline; the h1 stays the name alone, the role is a paragraph. -->
      <div class="headline">
        <h1 id="hero-title" class="name">
          {t.siteTitle}
        </h1>
        <p class="role text-accent font-display font-medium">{t.role}</p>
      </div>
      <p class="positioning max-w-measure text-muted">{t.heroPositioning}</p>
      <div class="flex flex-wrap gap-3">
        <CTAButton href={`${localeUrl(locale)}#contact`}>{t.navContact}</CTAButton>
        {CV_URL && (
          <CTAButton href={CV_URL} variant="secondary">
            {t.ctaCv}
          </CTAButton>
        )}
        <CTAButton href={GITHUB_URL} variant="secondary">
          {t.github}
        </CTAButton>
        <CTAButton href={LINKEDIN_URL} variant="secondary">
          {t.linkedin}
        </CTAButton>
      </div>
    </div>
    <!-- Decorative only; hidden on small screens so the CTAs stay in the first view. -->
    <div class="hidden lg:block">
      <HeroArchitecture />
    </div>
  </div>
</section>

<style>
  /* Availability dot: a soft blink plus a ring that fades outwards, like a live status light. */
  .status-dot {
    animation: blink 2.4s ease-in-out infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
    }
    50% {
      opacity: 0.45;
    }
    70% {
      box-shadow: 0 0 0 5px transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }

  /* Name and role at one size, like a two-line display headline: one line each on wide
     screens, wrapping on phones. */
  .headline {
    font-size: clamp(2.25rem, 0.6rem + 2.4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  .headline > * {
    line-height: inherit;
    text-wrap: wrap;
  }

  /* The role line is exactly as wide as the name. Text width scales linearly with font size,
     so the ratio is measured once per language (Inter Tight, weight 500, -0.01em tracking) and
     holds at every viewport. Re-measure if the name, the role text or the font changes. */
  .role {
    font-size: 0.676em;
  }

  .role:lang(de) {
    font-size: 0.64em;
  }

  /* 10% smaller than the text-lg it used to be. */
  .positioning {
    font-size: calc(var(--text-lg) * 0.9);
  }

  /* White with a slight downward fade, like the reference headline. Falls back to the plain
     text colour where background-clip: text is missing. */
  @supports (background-clip: text) {
    .name {
      background-image: linear-gradient(
        to bottom,
        var(--fg) 30%,
        color-mix(in srgb, var(--fg) 72%, var(--muted))
      );
      background-clip: text;
      color: transparent;
    }
  }

  /* The beams are clipped shapes; the blur sits on the parent, so it applies after the clip
     and every edge is soft. The section clips sideways only, so the shaft can reach up behind
     the translucent sticky header. */
  .shaft {
    display: none;
    position: absolute;
    z-index: -1;
    top: -7rem;
    right: 2%;
    width: 58%;
    height: calc(100% + 7rem);
    pointer-events: none;
    background: radial-gradient(ellipse 26% 16% at 58% 8%, var(--shaft-core), transparent);
    filter: blur(26px);
  }

  @media (min-width: 64rem) {
    .shaft {
      display: block;
    }
  }

  .shaft::before,
  .shaft::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Wide, faint beam. */
  .shaft::before {
    background: linear-gradient(to bottom, var(--shaft), transparent 80%);
    clip-path: polygon(46% 0, 70% 0, 96% 100%, 8% 100%);
  }

  /* Narrow, brighter core, fading out sooner. */
  .shaft::after {
    background: linear-gradient(to bottom, var(--shaft-core), transparent 60%);
    clip-path: polygon(54% 0, 62% 0, 66% 100%, 30% 100%);
    animation: breathe 9s ease-in-out infinite alternate;
  }

  @keyframes breathe {
    from {
      opacity: 0.7;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shaft::after {
      animation: none;
    }
  }
</style>
