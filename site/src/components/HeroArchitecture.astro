---
/*
 * Decorative hero graphic: a made-up AWS architecture on a dot-matrix panel, tilted in
 * perspective, with data packets travelling along the connections. Not a real system (the case
 * studies hold those), so it is aria-hidden and carries no claims.
 *
 * CSP: inline SVG markup only, no style attributes, no script. Layout uses SVG geometry
 * attributes; colours, perspective and animation live in this component's bundled stylesheet.
 * Icons are the official AWS Architecture Icons, unmodified, loaded from 'self'.
 * Packets: every path has pathLength=100 and a dash of 4 with a 120 gap, so one dash travels
 * the whole path and then disappears; delays stagger the hops into a chain.
 */
import { cloudIcon, icons } from '../diagrams/icons';

const S = 44; // icon size in viewBox units

// Two Availability Zones in one VPC; managed services outside the VPC on the right.
const nodes = [
  { x: 180, y: 302, icon: icons.elb, label: 'Load balancer' },
  { x: 320, y: 140, icon: icons.fargate, label: 'Fargate task' },
  { x: 320, y: 235, icon: icons.fargate, label: 'Fargate task' },
  { x: 320, y: 380, icon: icons.fargate, label: 'Fargate task' },
  { x: 320, y: 475, icon: icons.fargate, label: 'Fargate task' },
  { x: 500, y: 188, icon: icons.rds, label: 'RDS primary' },
  { x: 500, y: 428, icon: icons.rds, label: 'RDS replica' },
  { x: 725, y: 80, icon: icons.ecr, label: 'ECR' },
  { x: 725, y: 185, icon: icons.s3, label: 'S3' },
  { x: 725, y: 290, icon: icons.sns, label: 'SNS' },
  { x: 725, y: 395, icon: icons.ses, label: 'SES' },
  { x: 725, y: 495, icon: icons.guardduty, label: 'GuardDuty' },
];

// Dashed boxes with a text label (no group icons for these, so no symbol is invented).
const groups = [
  { x: 110, y: 46, w: 520, h: 496, label: 'VPC', cls: 'vpc', end: false },
  { x: 128, y: 74, w: 484, h: 220, label: 'Availability Zone A', cls: 'az', end: true },
  { x: 128, y: 310, w: 484, h: 220, label: 'Availability Zone B', cls: 'az', end: true },
];

// `hop` picks the animation delay class, so packets move through the system in order.
const edges = [
  { d: 'M0 302 H158', hop: 0 },
  { d: 'M202 302 H255 V140 H298', hop: 1 },
  { d: 'M202 302 H255 V235 H298', hop: 1 },
  { d: 'M202 302 H255 V380 H298', hop: 1 },
  { d: 'M202 302 H255 V475 H298', hop: 1 },
  { d: 'M342 140 H420 V188 H478', hop: 2 },
  { d: 'M342 235 H420 V188 H478', hop: 2 },
  { d: 'M342 380 H420 V428 H478', hop: 2 },
  { d: 'M342 475 H420 V428 H478', hop: 2 },
  { d: 'M320 118 V60 H660 V185 H703', hop: 2 },
  { d: 'M342 245 H395 V302 H680 V290 H703', hop: 2 },
  { d: 'M522 188 H565 V428 H522', hop: 3 },
  { d: 'M747 290 H795 V395 H747', hop: 3 },
];
// Control-plane links: dashed, no packets.
const watch = ['M703 80 H640 V140 H342', 'M703 495 H630'];
---

<div class="scene" aria-hidden="true">
  <div class="panel">
    <svg viewBox="0 0 840 560" class="graph" focusable="false">
      <rect class="frame" x="80" y="6" width="750" height="548" rx="10"></rect>
      <image class="cloud-light" href={cloudIcon.light} x="80" y="6" width="28" height="28" />
      <image class="cloud-dark" href={cloudIcon.dark} x="80" y="6" width="28" height="28" />
      <text class="group-label" x="116" y="25">
        AWS Cloud
      </text>
      <text class="label" x="818" y="25" text-anchor="end">
        eu-central-1
      </text>

      {groups.map((g) => (
        <>
          <rect
            class:list={['group', g.cls]}
            x={g.x}
            y={g.y}
            width={g.w}
            height={g.h}
            rx="8"
          ></rect>
          <text
            class="group-label"
            x={g.end ? g.x + g.w - 12 : g.x + 12}
            y={g.y + 18}
            text-anchor={g.end ? 'end' : 'start'}
          >
            {g.label}
          </text>
        </>
      ))}

      {watch.map((d) => (
        <path class="watch" d={d}></path>
      ))}
      {edges.map((e) => (
        <path class="wire" d={e.d} pathLength="100"></path>
      ))}
      {edges.map((e) => (
        <path class:list={['pkt', `hop-${e.hop}`]} d={e.d} pathLength="100"></path>
      ))}

      {nodes.map((n) => (
        <g transform={`translate(${n.x - S / 2} ${n.y - S / 2})`}>
          <rect class="halo" x="-5" y="-5" width={S + 10} height={S + 10} rx="10"></rect>
          <image href={n.icon} width={S} height={S} />
          <text class="label" x={S / 2} y={S + 18} text-anchor="middle">
            {n.label}
          </text>
        </g>
      ))}
    </svg>
  </div>
</div>

<style>
  .scene {
    perspective: 1600px;
    /* Fade the edges into the page, like a screenshot floating on the canvas. */
    mask-image: radial-gradient(ellipse 75% 70% at 50% 45%, #000 55%, transparent 100%);
  }

  /* Larger than its grid column and pulled up and to the left, so it nearly touches the hero
     text; the hero clips sideways overflow and the mask fades every edge. */
  @media (min-width: 64rem) {
    .scene {
      width: 122%;
      margin: -4rem 0 0 -10%;
    }
  }

  @media (min-width: 80rem) {
    .scene {
      width: 142%;
      margin: -6rem 0 0 -14%;
    }
  }

  /* No box: no border or fill, so nothing has a hard edge. The dot grid and the scene mask
     fade everything into the canvas. */
  .panel {
    position: relative;
    isolation: isolate;
    padding: 1.25rem;
    transform: rotateX(14deg) rotateY(-20deg) rotateZ(2deg);
    transform-origin: 40% 50%;
  }

  /* Dot matrix behind the graph: densest under the middle, gone well before any edge. */
  .panel::before {
    content: '';
    position: absolute;
    inset: -6%;
    z-index: -1;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--fg) 18%, transparent) 1px,
      transparent 1.5px
    );
    background-size: 12px 12px;
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 30%, transparent 100%);
  }

  .graph {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .frame {
    fill: none;
    stroke: var(--border-strong);
    stroke-opacity: 0.5;
  }

  .group {
    fill: none;
    stroke: var(--border-strong);
    stroke-opacity: 0.45;
  }

  .vpc {
    fill: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  .az {
    stroke-dasharray: 5 4;
  }

  .group-label,
  .label {
    fill: var(--muted);
    font-size: 13px;
  }

  .group-label {
    font-weight: 500;
  }

  .halo {
    fill: var(--bg);
    stroke: var(--border);
  }

  .wire,
  .watch {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.25;
    stroke-opacity: 0.6;
  }

  .watch {
    stroke-dasharray: 4 4;
  }

  .pkt {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 4 120;
    stroke-dashoffset: 4;
    filter: drop-shadow(0 0 4px var(--accent));
    animation: flow 2.4s linear infinite;
  }

  .hop-1 {
    animation-delay: 0.6s;
  }
  .hop-2 {
    animation-delay: 1.2s;
  }
  .hop-3 {
    animation-delay: 1.8s;
  }

  @keyframes flow {
    from {
      stroke-dashoffset: 4;
    }
    to {
      stroke-dashoffset: -120;
    }
  }

  .cloud-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .cloud-light {
      display: none;
    }
    .cloud-dark {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pkt {
      display: none;
    }
  }
</style>
