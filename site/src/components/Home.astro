---
import { type Locale, useTranslations } from '../i18n';
import Hero from './Hero.astro';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Page order: pitch first (work, skills, about), then the freelance offer, then contact.
// Section ids are the anchors the header links to. Content arrives section by section (Phase 4).
const sections = [
  { id: 'work', title: t.workTitle },
  { id: 'skills', title: t.skillsTitle },
  { id: 'about', title: t.aboutTitle },
  { id: 'hire', title: t.hireTitle },
  { id: 'contact', title: t.contactTitle },
];
---

<Hero locale={locale} />

{sections.map((s) => (
  <Section id={s.id} title={s.title}>
    <p class="text-muted">{t.comingSoon}</p>
  </Section>
))}
