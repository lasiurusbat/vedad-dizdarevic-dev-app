---
import { type Locale, useTranslations } from '../i18n';
import { caseStudyPath, getCaseStudies, slugOf } from '../lib/caseStudies';
import About from './About.astro';
import CaseStudyCard from './CaseStudyCard.astro';
import ContactForm from './ContactForm.astro';
import Credentials from './Credentials.astro';
import Hero from './Hero.astro';
import Section from './Section.astro';
import SkillGroup from './SkillGroup.astro';
import WorkWithMe from './WorkWithMe.astro';
import { skillGroups, text } from '../skills';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const caseStudies = await getCaseStudies(locale);
// Page order: pitch first (work, skills, about), then the freelance offer, then contact. Section
// ids are the anchors the header links to.
---

<Hero locale={locale} />

<Section id="work" title={t.workTitle} bloom>
  <div class="grid gap-4 md:grid-cols-2">
    {caseStudies.map((study) => (
      <CaseStudyCard
        locale={locale}
        title={study.data.title}
        summary={study.data.summary}
        href={caseStudyPath(locale, slugOf(study))}
        tags={study.data.stack}
      />
    ))}
  </div>
</Section>

<Section id="skills" title={t.skillsTitle}>
  <div class="space-y-12">
    <div class="grid gap-x-8 gap-y-8 md:grid-cols-2">
      {skillGroups.map((g) => (
        <SkillGroup title={g.title[locale]} items={g.items.map((i) => text(i, locale))} />
      ))}
    </div>
    <Credentials locale={locale} />
  </div>
</Section>

<Section id="about" title={t.aboutTitle}>
  <About locale={locale} />
</Section>

<Section id="hire" title={t.hireTitle}>
  <WorkWithMe locale={locale} />
</Section>

<Section id="contact" title={t.contactTitle} bloom>
  <ContactForm locale={locale} />
</Section>
