---
import { type Locale, useTranslations } from '../i18n';
import { caseStudyPath, getCaseStudies, slugOf } from '../lib/caseStudies';
import CaseStudyCard from './CaseStudyCard.astro';
import Credentials from './Credentials.astro';
import Hero from './Hero.astro';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const caseStudies = await getCaseStudies(locale);

// Page order: pitch first (work, skills, about), then the freelance offer, then contact.
// Section ids are the anchors the header links to. Content arrives section by section (Phase 4).
const sections = [
  { id: 'work', title: t.workTitle },
  { id: 'skills', title: t.skillsTitle },
  { id: 'about', title: t.aboutTitle },
  { id: 'hire', title: t.hireTitle },
  { id: 'contact', title: t.contactTitle },
];
---

<Hero locale={locale} />

{sections.map((s, i) => (
  <Section id={s.id} title={s.title} bloom={i === 0}>
    {s.id === 'work' && caseStudies.length > 0 ? (
      <div class="grid gap-4 md:grid-cols-2">
        {caseStudies.map((study) => (
          <CaseStudyCard
            locale={locale}
            title={study.data.title}
            summary={study.data.summary}
            href={caseStudyPath(locale, slugOf(study))}
            tags={study.data.stack}
          />
        ))}
      </div>
    ) : s.id === 'skills' ? (
      <Credentials locale={locale} />
    ) : s.id === 'about' ? (
      <div class="max-w-measure space-y-4 text-lg">
        <p>{t.aboutP1}</p>
        <p>{t.aboutP2}</p>
        <p>{t.aboutP3}</p>
      </div>
    ) : (
      <p class="text-muted">{t.comingSoon}</p>
    )}
  </Section>
))}
