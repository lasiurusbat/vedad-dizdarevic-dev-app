---
import { type Locale, useTranslations } from '../i18n';
import { caseStudyPath, getCaseStudies, slugOf } from '../lib/caseStudies';
import CaseStudyCard from './CaseStudyCard.astro';
import ContactForm from './ContactForm.astro';
import Credentials from './Credentials.astro';
import Hero from './Hero.astro';
import Section from './Section.astro';
import SkillGroup from './SkillGroup.astro';
import WorkWithMe from './WorkWithMe.astro';
import { skillGroups, text } from '../skills';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const caseStudies = await getCaseStudies(locale);
// About names Sorted in its second paragraph; `{sorted}` in the string marks where the link goes.
const [aboutP2Before, aboutP2After] = t.aboutP2.split('{sorted}');

// Page order: pitch first (work, skills, about), then the freelance offer, then contact.
// Section ids are the anchors the header links to. Content arrives section by section (Phase 4).
const sections = [
  { id: 'work', title: t.workTitle },
  { id: 'skills', title: t.skillsTitle },
  { id: 'about', title: t.aboutTitle },
  { id: 'hire', title: t.hireTitle },
  { id: 'contact', title: t.contactTitle },
];
---

<Hero locale={locale} />

{sections.map((s, i) => (
  <Section id={s.id} title={s.title} bloom={i === 0}>
    {s.id === 'work' && caseStudies.length > 0 ? (
      <div class="grid gap-4 md:grid-cols-2">
        {caseStudies.map((study) => (
          <CaseStudyCard
            locale={locale}
            title={study.data.title}
            summary={study.data.summary}
            href={caseStudyPath(locale, slugOf(study))}
            tags={study.data.stack}
          />
        ))}
      </div>
    ) : s.id === 'skills' ? (
      <div class="space-y-12">
        <div class="grid gap-x-8 gap-y-8 md:grid-cols-2">
          {skillGroups.map((g) => (
            <SkillGroup title={g.title[locale]} items={g.items.map((i) => text(i, locale))} />
          ))}
        </div>
        <Credentials locale={locale} />
      </div>
    ) : s.id === 'about' ? (
      <div class="max-w-measure space-y-4 text-lg">
        <p>{t.aboutP1}</p>
        <p>
          {aboutP2Before}
          <a href={caseStudyPath(locale, 'sorted')} class="underline">
            Sorted
          </a>
          {aboutP2After}
        </p>
        <p>{t.aboutP3}</p>
        <p class="text-muted text-base">
          <span class="text-fg font-medium">{t.aboutLanguagesLabel}:</span> {t.aboutLanguages}
        </p>
      </div>
    ) : s.id === 'hire' ? (
      <WorkWithMe locale={locale} />
    ) : s.id === 'contact' ? (
      <ContactForm locale={locale} />
    ) : (
      <p class="text-muted">{t.comingSoon}</p>
    )}
  </Section>
))}
