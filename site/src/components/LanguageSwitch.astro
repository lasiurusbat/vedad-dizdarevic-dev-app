---
import { type Locale, defaultLocale, locales, useTranslations } from '../i18n';
import { LANGUAGE_NAMES } from '../data/site';

interface Props {
  locale: Locale;
  urls: Record<Locale, string>;
}

const { locale, urls } = Astro.props;
const t = useTranslations(locale);

// The English home link carries `?lang=en`: the Worker sends first-time visitors from Germany,
// Austria, Switzerland, Luxembourg and Liechtenstein to /de/, and this marks English as a choice.
const href = (l: Locale) => (l === defaultLocale && urls[l] === '/' ? '/?lang=en' : urls[l]);
---

<nav aria-label={t.language} class="flex items-center">
  {locales.map((l) => (
    <a
      href={href(l)}
      lang={l}
      hreflang={l}
      aria-current={l === locale ? 'true' : undefined}
      class:list={[
        'inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-sm font-medium',
        l === locale
          ? 'text-fg underline decoration-2 underline-offset-8'
          : 'text-muted hover:text-fg',
      ]}
    >
      {l.toUpperCase()}
      <span class="sr-only"> {LANGUAGE_NAMES[l]}</span>
    </a>
  ))}
</nav>
