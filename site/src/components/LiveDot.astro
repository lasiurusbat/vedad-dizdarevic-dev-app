---
/* The "this is live" dot: green with one slow ripple every few seconds, alive but not busy. */
---

<span class="live-dot" aria-hidden="true"></span>

<style>
  .live-dot {
    --live: light-dark(#2f7d55, #6cc795);

    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 6px var(--live);
  }

  .live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--live);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .live-dot::after {
      animation: ripple 3.2s ease-out infinite;
    }
  }

  @keyframes ripple {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    45%,
    100% {
      opacity: 0;
      transform: scale(3);
    }
  }
</style>
