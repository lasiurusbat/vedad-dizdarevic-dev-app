---
/*
 * Symbolic header illustration for Rain Alert, in the same language as CaseIllustration (Sorted):
 * line art in the site tokens on a tilted dot-matrix plane, one accent motion, decorative
 * (aria-hidden). It shows the problem the app solves: will it rain where I am, and when do I need
 * an umbrella?
 *
 * The motion is one 12-second day: a "now" marker sweeps Dublin's 24-hour strip (the hours from
 * the app screenshot). In the wet hours the rain thickens, the umbrella lights up in the accent
 * and "take an umbrella" appears, then it all fades back: the app answers when, not only whether.
 *
 * CSP: inline SVG only, no style attributes. Rain streaks are paths with pathLength=100 and a short
 * dash that runs along them (the same technique as the packets on the home hero), staggered by
 * classes; synchronised motion shares one cycle length. Reduced motion: everything stands still
 * in a meaningful state.
 */
export type RainVariant = 'umbrella';

interface Props {
  /** The only variant; kept as a prop so the layout can treat both illustrations alike. */
  variant: RainVariant;
}

/** A flat-bottomed cloud, 160 x 62 at scale 1. */
const cloud =
  'M20 60 H140 A20 20 0 0 0 140 20 A30 30 0 0 0 86 8 A26 26 0 0 0 40 22 A19 19 0 0 0 20 60 Z';

const band = (p: number) => (p >= 60 ? 'likely' : p >= 20 ? 'possible' : 'unlikely');

/* umbrella: Dublin's hours from the app screenshot. */
const hours = [
  4, 0, 0, 0, 1, 3, 6, 9, 12, 22, 46, 76, 94, 87, 67, 51, 46, 44, 45, 49, 55, 55, 43, 26,
];
const hx = (h: number) => 40 + h * 18.6;
const canopy = (x: number) => 200 - (1 - ((x - 260) / 92) ** 2) * 48;
const rain = Array.from({ length: 22 }, (_, i) => {
  const x = 24 + i * 22.5;
  const under = x > 170 && x < 350;
  return { x, top: 92 + ((i * 17) % 26), bottom: under ? canopy(x) - 6 : 330, k: i % 5 };
});
---

<div class="illo" aria-hidden="true">
  <div class="plane">
    <svg viewBox="0 0 520 440" focusable="false">
      <path class="cloud faint" d={cloud} transform="translate(-6 24) scale(1.1 0.9)"></path>
      <path class="cloud" d={cloud} transform="translate(150 6) scale(1.5 1.15)"></path>
      <path class="cloud faint" d={cloud} transform="translate(372 30) scale(0.95 0.85)"></path>
      <g class="shower">
        {rain.map((r) => (
          <path
            class:list={['drop', `d${r.k}`]}
            d={`M${r.x + 8} ${r.top} L${r.x} ${r.bottom}`}
            pathLength="100"
          ></path>
        ))}
      </g>
      <g class="umbrella">
        <path
          class="canopy"
          d="M168 200 Q260 104 352 200 Q329 184 306 200 Q283 184 260 200 Q237 184 214 200 Q191 184 168 200 Z"
        ></path>
        <path class="shaft" d="M260 200 V286 q0 14 -14 14 q-12 0 -12 -12"></path>
      </g>
      <text class="advice" x="260" y="330" text-anchor="middle">
        take an umbrella
      </text>
      {/* The day, hour by hour: the bars carry the chance, the marker is "now". */}
      <path class="ground" d="M30 410 H492"></path>
      {hours.map((p, h) => (
        <rect
          class:list={['bar', 'thin', band(p)]}
          x={hx(h)}
          y={410 - Math.max(3, p * 0.62)}
          width="12"
          height={Math.max(3, p * 0.62)}
          rx="2"
        ></rect>
      ))}
      <text class="label" x={hx(0) + 6} y="430" text-anchor="middle">
        00
      </text>
      <text class="label" x={hx(12) + 6} y="430" text-anchor="middle">
        12
      </text>
      <text class="label" x={hx(23) + 6} y="430" text-anchor="middle">
        23
      </text>
      <g class="now">
        <path class="now-line" d={`M${hx(0) + 6} 336 V414`}></path>
        <text class="now-label" x={hx(0) + 6} y="350" text-anchor="middle">
          now
        </text>
      </g>
    </svg>
  </div>
</div>

<style>
  /* Wrapper, plane and dot matrix: the same as CaseIllustration, so both case studies match. */
  .illo {
    animation: appear 0.6s ease-out 0.1s both;
    perspective: 1100px;
    overflow: clip;
    mask-image: radial-gradient(ellipse 72% 70% at 50% 50%, #000 62%, transparent 100%);
  }

  .plane {
    position: relative;
    isolation: isolate;
    transform: rotateX(18deg) rotateY(-30deg) rotateZ(2.5deg);
    transform-origin: 40% 50%;
  }

  .plane::before {
    content: '';
    position: absolute;
    inset: -4%;
    z-index: -1;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--fg) 16%, transparent) 1px,
      transparent 1.5px
    );
    background-size: 12px 12px;
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 25%, transparent 100%);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .label {
    fill: var(--muted);
    font-size: 12px;
  }

  .cloud {
    fill: color-mix(in srgb, var(--surface) 85%, transparent);
    stroke: var(--border-strong);
    stroke-width: 1.2;
  }

  .cloud.faint {
    stroke-opacity: 0.5;
    fill: color-mix(in srgb, var(--surface) 50%, transparent);
  }

  .ground {
    stroke: var(--border-strong);
    stroke-opacity: 0.6;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
  }

  /* Rain: a short dash runs down each path and disappears, like the packets on the home hero. */
  .drop {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 16 120;
    stroke-dashoffset: 16;
    opacity: 0.85;
    animation: fall 1.3s linear infinite;
  }

  .d1 {
    animation-delay: -0.26s;
  }
  .d2 {
    animation-delay: -0.52s;
  }
  .d3 {
    animation-delay: -0.78s;
  }
  .d4 {
    animation-delay: -1.04s;
  }

  /* Three bands, as in the app: unlikely is an outline, possible a faint fill, likely lit. */
  .bar {
    stroke-width: 1.2;
  }

  .bar.unlikely {
    fill: none;
    stroke: var(--border-strong);
    stroke-opacity: 0.7;
  }

  .bar.possible {
    fill: color-mix(in srgb, var(--accent) 18%, transparent);
    stroke: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .bar.likely {
    fill: color-mix(in srgb, var(--accent) 55%, transparent);
    stroke: var(--accent);
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--accent) 45%, transparent));
  }

  /* umbrella: one 12-second day. The marker crosses 24 hours; hours 10 to 21 are the wet ones
     (42% to 92% of the cycle), and the rain, the umbrella and the advice follow it. */
  .canopy {
    fill: color-mix(in srgb, var(--surface) 80%, transparent);
    stroke: var(--border-strong);
    stroke-width: 1.4;
    stroke-linejoin: round;
    animation: open 12s linear infinite;
  }

  .shaft {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.6;
    stroke-linecap: round;
    animation: open-shaft 12s linear infinite;
  }

  .shower {
    animation: shower 12s linear infinite;
  }

  .advice {
    fill: var(--fg);
    font-family: var(--font-display, inherit);
    font-size: 16px;
    font-weight: 500;
    opacity: 0;
    animation: advice 12s linear infinite;
  }

  .now {
    animation: scan 12s linear infinite;
  }

  .now-line {
    stroke: var(--fg);
    stroke-width: 1.2;
  }

  .now-label {
    fill: var(--fg);
    font-size: 11px;
    font-weight: 600;
  }

  @keyframes fall {
    from {
      stroke-dashoffset: 16;
    }
    to {
      stroke-dashoffset: -100;
    }
  }

  @keyframes scan {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(428px);
    }
  }

  @keyframes shower {
    0%,
    40% {
      opacity: 0.25;
    }
    44%,
    90% {
      opacity: 1;
    }
    94%,
    100% {
      opacity: 0.25;
    }
  }

  @keyframes open {
    0%,
    41% {
      fill: color-mix(in srgb, var(--surface) 80%, transparent);
      stroke: var(--border-strong);
      filter: none;
    }
    44%,
    90% {
      fill: color-mix(in srgb, var(--accent) 28%, var(--bg));
      stroke: var(--accent);
      filter: drop-shadow(0 0 14px color-mix(in srgb, var(--accent) 50%, transparent));
    }
    93%,
    100% {
      fill: color-mix(in srgb, var(--surface) 80%, transparent);
      stroke: var(--border-strong);
      filter: none;
    }
  }

  @keyframes open-shaft {
    0%,
    41% {
      stroke: var(--border-strong);
    }
    44%,
    90% {
      stroke: var(--accent);
    }
    93%,
    100% {
      stroke: var(--border-strong);
    }
  }

  @keyframes advice {
    0%,
    42% {
      opacity: 0;
    }
    46%,
    88% {
      opacity: 1;
    }
    92%,
    100% {
      opacity: 0;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  /* Reduced motion: still, in a meaningful state (the wet afternoon for the umbrella). */
  @media (prefers-reduced-motion: reduce) {
    .illo,
    .drop,
    .shower,
    .canopy,
    .shaft,
    .advice,
    .now {
      animation: none;
    }

    .drop {
      display: none;
    }

    .now {
      transform: translateX(335px);
    }

    .canopy {
      fill: color-mix(in srgb, var(--accent) 28%, var(--bg));
      stroke: var(--accent);
    }

    .shaft {
      stroke: var(--accent);
    }

    .advice {
      opacity: 1;
    }
  }
</style>
