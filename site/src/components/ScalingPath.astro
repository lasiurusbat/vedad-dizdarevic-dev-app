---
/*
 * Availability and scaling as a path in three stages: what runs today, what a few Terraform
 * settings switch on, and what the design allows next. A real sequence, so it is drawn as one: a
 * rail with a node per stage, vertical on phones and horizontal on wide screens, the same visual
 * language as the tech stack. The status of each stage is stated in words, never implied: a
 * stage that is designed but not built says so. Text in `backticks` renders as inline code.
 *
 * Semantics: an ordered list of stages, each with a heading and a list of points.
 */
interface Stage {
  title: string;
  /** Where this stage stands, in plain words, e.g. 'Running today'. */
  status: string;
  /** The stage that is live gets the filled node. */
  current?: boolean;
  points: string[];
}

interface Props {
  label: string;
  stages: Stage[];
}

const { label, stages } = Astro.props;

const parts = (s: string) =>
  s
    .split(/(`[^`]+`)/)
    .map((p) =>
      p.startsWith('`') && p.endsWith('`')
        ? { code: true, text: p.slice(1, -1) }
        : { code: false, text: p },
    );
---

<ol class="not-prose path my-8" aria-label={label}>
  {stages.map((s) => (
    <li class:list={['stage', s.current && 'is-current']}>
      <span class="node" aria-hidden="true" />
      <p class="status">{s.status}</p>
      <h3 class="title font-display">{s.title}</h3>
      <ul class="points" role="list">
        {s.points.map((p) => (
          <li>{parts(p).map((x) => (x.code ? <code>{x.text}</code> : x.text))}</li>
        ))}
      </ul>
    </li>
  ))}
</ol>

<style>
  .path {
    display: grid;
    gap: 0;
  }

  .stage {
    position: relative;
    padding: 0 0 2rem 2rem;
  }

  /* Rail segment from this node to the next one. */
  .stage:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 0.75rem;
    bottom: -0.25rem;
    left: 0.3125rem;
    width: 1px;
    background: var(--border-strong);
  }

  .node {
    position: absolute;
    top: 0.25rem;
    left: 0;
    width: 0.6875rem;
    height: 0.6875rem;
    border: 2px solid var(--accent);
    border-radius: 9999px;
    background: var(--bg);
  }

  .is-current .node {
    background: var(--accent);
  }

  .status {
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .title {
    margin-top: 0.25rem;
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
  }

  .points {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .points li {
    padding-left: 0.875rem;
    border-left: 1px solid var(--border);
  }

  code {
    padding: 0.0625rem 0.375rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--surface);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.85em;
    white-space: nowrap;
  }

  /* Wide screens: three columns on a horizontal rail, out to the page width. */
  @media (min-width: 64rem) {
    .path {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
      width: min(
        calc(var(--container-page) - 2 * var(--spacing-gutter)),
        calc(100vw - 2 * var(--spacing-gutter) - 1.5rem)
      );
    }

    .stage {
      padding: 1.75rem 0 0;
    }

    .stage:not(:last-child)::before {
      top: 0.3125rem;
      bottom: auto;
      left: 1rem;
      right: -2rem;
      width: auto;
      height: 1px;
    }

    .node {
      top: 0;
    }
  }
</style>
