---
/*
 * Horizontal screenshot gallery for case studies, after the betterstack.com feature rows: a row
 * of cards that scrolls sideways (swipe, trackpad, keyboard, or the prev/next buttons), with the
 * cards running off the edge faded out. Each screenshot bleeds off the card's right edge and
 * fades towards the bottom; it zooms in slightly on hover or focus,
 * and settles from a slight zoom as it scrolls into view where scroll-driven animations exist.
 *
 * Light/dark pairs: both are rendered and the theme classes show the active one, like
 * ThemedScreenshot. Images go through Astro's image pipeline (WebP under /_astro/), lazy-loaded.
 *
 * Each screenshot links to its full-size WebP. With JavaScript the link opens a lightbox (a native
 * <dialog>): fitted to the window, with an "actual size" toggle when the image is larger than that.
 * New-tab clicks keep working, since it stays a real link.
 *
 * Progressive enhancement: without JavaScript the row still scrolls natively, the buttons stay
 * hidden and the links open the image itself. CSP: no inline styles or scripts; state is classes and attributes only. Under
 * prefers-reduced-motion there is no zoom and scrolling is instant.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLocale, useTranslations } from '../i18n';

interface Item {
  /** The screenshot; with `dark`, the light-UI version of a pair. */
  light: ImageMetadata;
  /** The dark-UI version. Without it the single image shows in both themes (RainAlert). */
  dark?: ImageMetadata;
  /** Describes what the screenshot shows. Required, never "screenshot". */
  alt: string;
  title: string;
  text: string;
}

interface Props {
  /** Accessible name of the scrolling region. */
  label: string;
  /** Optional badge shown on top of every screenshot, e.g. "Demo data". */
  badge?: string;
  items: Item[];
}

const { label, badge, items } = Astro.props;
const t = useTranslations(getLocale(Astro.currentLocale));

const widths = [640, 960, 1440];
const sizes = '(min-width: 72rem) 56rem, 80vw';

async function variants(src: ImageMetadata) {
  const images = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp' })));
  // Only fetched when someone opens it, so it does not count towards the page weight.
  const full = await getImage({ src, format: 'webp' });
  return {
    srcset: images.map((i, n) => `${i.src} ${widths[n]}w`).join(', '),
    src: images[1]!.src,
    full: full.src,
    width: src.width,
    height: src.height,
  };
}

const cards = await Promise.all(
  items.map(async (i) => ({
    ...i,
    // One link per image of a pair: the theme class hides the other, so the href always matches.
    versions: i.dark
      ? [
          { theme: 'only-light', ...(await variants(i.light)) },
          { theme: 'only-dark', ...(await variants(i.dark)) },
        ]
      : [{ theme: undefined, ...(await variants(i.light)) }],
  })),
);
---

<figure class="not-prose gallery my-10" data-gallery>
  <div class="controls" hidden data-controls>
    <button type="button" class="ctl" aria-label={t.galleryPrev} data-prev>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M10 3 5 8l5 5"></path>
      </svg>
    </button>
    <button type="button" class="ctl" aria-label={t.galleryNext} data-next>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="m6 3 5 5-5 5"></path>
      </svg>
    </button>
  </div>

  {/* Focusable so keyboard users can scroll it with the arrow keys. */}
  <div class="track" role="region" aria-label={label} tabindex="0" data-track>
    <ul class="row" role="list">
      {cards.map((c) => (
        <li class="item card border-border rounded-lg border">
          {badge && <p class="badge">{badge}</p>}
          {c.versions.map((v) => (
            <a href={v.full} class:list={['shot-link', v.theme]} data-zoom>
              <span class="expand" aria-hidden="true">
                <svg viewBox="0 0 16 16" focusable="false">
                  <path d="M9.5 2.5h4v4 M13.5 2.5 9 7 M6.5 13.5h-4v-4 M2.5 13.5 7 9"></path>
                </svg>
              </span>
              <div class="shot">
                <div class="pic">
                  <img
                    class:list={[v.theme]}
                    src={v.src}
                    srcset={v.srcset}
                    sizes={sizes}
                    alt={c.alt}
                    width={v.width}
                    height={v.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
              <span class="sr-only">{t.galleryOpen}</span>
            </a>
          ))}
          <div class="body">
            <p class="font-display text-lg font-medium" data-title>
              {c.title}
            </p>
            <p class="text-muted mt-2">{c.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>

  {/* The image is created when it opens, so nothing loads until someone asks for it. */}
  <dialog class="lightbox" aria-label={label} data-lightbox>
    <div class="bar">
      <div class="label">
        <p class="caption" data-caption></p>
        {badge && <p class="badge">{badge}</p>}
      </div>
      <button type="button" class="actual-btn" aria-pressed="false" hidden data-actual>
        {t.galleryActualSize}
      </button>
      <button type="button" class="ctl" aria-label={t.galleryClose} autofocus data-close>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="m4 4 8 8 M12 4l-8 8"></path>
        </svg>
      </button>
    </div>
    {/* Focusable so keyboard users can scroll an image shown at actual size. */}
    <div class="stage" role="region" aria-label={label} tabindex="0" data-stage></div>
  </dialog>
</figure>

<style>
  .controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .controls[hidden] {
    display: none;
  }

  .ctl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--fg);
    border-radius: 0.625rem;
    cursor: pointer;
  }

  .ctl svg {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.625rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.625rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: background-color 0.2s ease;
  }

  .ctl:hover svg {
    background: var(--surface);
  }

  .ctl:disabled {
    cursor: default;
    opacity: 0.35;
  }

  .track {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: 1rem;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  /* Edge fades, set by the script from the scroll position. */
  .track.fade-end {
    mask-image: linear-gradient(to right, #000 calc(100% - 7rem), transparent);
  }
  .track.fade-start {
    mask-image: linear-gradient(to right, transparent, #000 4rem);
  }
  .track.fade-start.fade-end {
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 4rem,
      #000 calc(100% - 7rem),
      transparent
    );
  }

  .row {
    display: flex;
    gap: 1rem;
  }

  .item {
    display: flex;
    /* One full card plus a quarter of the next: w + gap + w/4 = 100%. */
    flex: 0 0 calc((100% - 1rem) * 0.8);
    flex-direction: column;
    overflow: hidden;
    scroll-snap-align: start;
  }

  /* Pill above the screenshot's top edge, so it hides nothing. Outside .shot, so the
     screenshot's fade does not touch it. */
  .badge {
    position: absolute;
    z-index: 1;
    top: 0.5rem;
    right: 1rem;
    padding: 0.125rem 0.625rem;
    border: 1px solid color-mix(in srgb, var(--fg) 20%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(8px);
    color: var(--fg);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.4;
  }

  .shot-link {
    position: relative;
    display: block;
    margin: 1.75rem 0 0 1.25rem;
    border-radius: 0.5rem 0 0 0;
    cursor: zoom-in;
  }

  /* The card clips what is outside it, so the focus ring stays inside the link. */
  .shot-link:focus-visible {
    outline-offset: -2px;
  }

  /* Always visible, since a touch screen has no hover and no zoom cursor. Outside .shot, so the
     screenshot's fade does not touch it. */
  .expand {
    position: absolute;
    z-index: 1;
    top: 0.5rem;
    left: 0.5rem;
    display: flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--fg) 20%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(8px);
    color: var(--fg);
  }

  .expand svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The screenshot bleeds off the right edge of the card and fades out towards the bottom. */
  .shot {
    mask-image: linear-gradient(to bottom, #000 55%, transparent 98%);
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .shot .pic {
    display: block;
    overflow: hidden;
    border-radius: 0.5rem 0 0 0;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: top left;
    transition: transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .item:hover .shot img,
  .item:focus-within .shot img {
    transform: scale(1.04);
  }

  /* Settles from a slight zoom as the card scrolls into view. Uses `scale`, so it composes
     with the hover `transform`. */
  @supports (animation-timeline: view()) {
    .shot img {
      animation: settle linear both;
      animation-timeline: view(inline);
      animation-range: entry 0% cover 45%;
    }
  }

  @keyframes settle {
    from {
      scale: 1.08;
    }
    to {
      scale: 1;
    }
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.5rem 1.5rem 1.25rem;
  }

  /* The lightbox fills the window; closed, the browser keeps it display: none. */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--fg);
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
  }

  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }

  .bar {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.5rem 0.25rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .label {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    min-width: 0;
  }

  .caption {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  /* The screenshot's label stays with it at full size, here beside the caption. */
  .label .badge {
    position: static;
  }

  .actual-btn {
    flex: none;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.625rem;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .actual-btn[hidden] {
    display: none;
  }

  .actual-btn:hover,
  .actual-btn[aria-pressed='true'] {
    background: var(--surface);
  }

  .stage {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 1rem;
  }

  /* Created by the script, hence :global. Auto margins centre it and, unlike centring on the flex
     container, leave the start of an oversized image reachable by scrolling. */
  .stage :global(img) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    margin: auto;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .stage.zoomable :global(img) {
    cursor: zoom-in;
  }

  .stage.actual :global(img) {
    flex: none;
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }

  /* On wide screens the gallery breaks out of the 70ch text column, up to the page width. */
  @media (min-width: 64rem) {
    .gallery {
      width: min(
        calc(var(--container-page) - 2 * var(--spacing-gutter)),
        calc(100vw - 2 * var(--spacing-gutter) - 1.5rem)
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot img {
      transition: none;
      animation: none;
    }
    .item:hover .shot img,
    .item:focus-within .shot img {
      transform: none;
    }
  }
</style>

<script>
  import { initGallery } from '../scripts/screenshot-gallery';

  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) initGallery(root);
</script>
