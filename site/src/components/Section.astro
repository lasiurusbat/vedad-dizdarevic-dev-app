---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="section py-section">
  <div class="max-w-page px-gutter mx-auto">
    <h2 id={`${id}-title`} class="text-3xl">
      {title}
    </h2>
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>

<style>
  /* Divider between sections: a hairline across the page that fades at both ends, with a soft
     bloom spilling downwards from it. Above the line stays the opaque canvas; the light only
     shows below, which gives the page depth. Decorative pseudo-elements, behind the content. */
  .section {
    position: relative;
    isolation: isolate;
  }

  .section::before,
  .section::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .section::before {
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--divider) 15%,
      var(--divider) 85%,
      transparent
    );
  }

  .section::after {
    z-index: -1;
    height: 18rem;
    background: radial-gradient(ellipse 45% 100% at 50% 0, var(--bloom), transparent 70%);
  }
</style>
