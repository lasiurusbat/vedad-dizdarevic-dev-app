---
interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
---

<div class="not-prose">
  <h3 class="text-xl">{title}</h3>
  <ul class="mt-3 flex flex-wrap gap-2" role="list">
    {items.map((item) => (
      <li class="border-border bg-surface rounded-md border px-3 py-1 text-sm">{item}</li>
    ))}
  </ul>
</div>
