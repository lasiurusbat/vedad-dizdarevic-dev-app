---
/*
 * "Where it stands" for a project that is still moving: an ordered track of stages, each marked
 * by its state (running, not yet checked, planned) instead of a number. The rail between two
 * stages is solid where the earlier stage runs and dashed where it does not yet, so the eye finds
 * "how far along" before reading a word.
 *
 * A stage has a title, an optional lead sentence, a short list (checked items for a running stage,
 * open items otherwise), optional service names, optional labelled groups, and the next step.
 * Semantics: an ordered list of stages with h3 titles; the state word is visible text, the markers
 * are decoration. Quiet on purpose: no cards and no motion; the rail is the one bold element.
 */
import { getLocale, useTranslations } from '../i18n';

type State = 'done' | 'open' | 'planned';

interface Stage {
  state: State;
  title: string;
  /** One sentence before the list. */
  lead?: string;
  items?: string[];
  /** Names of the parts this stage adds, shown as small tags. */
  services?: string[];
  groups?: { label: string; items: string[] }[];
  next: string;
}

interface Props {
  label: string;
  stages: Stage[];
}

const { label, stages } = Astro.props;
const t = useTranslations(getLocale(Astro.currentLocale));
const stateWord: Record<State, string> = {
  done: t.trackDone,
  open: t.trackOpen,
  planned: t.trackPlanned,
};
---

<ol class="not-prose track my-8" aria-label={label}>
  {stages.map((s) => (
    <li class:list={['stage', s.state]}>
      <span class="marker" aria-hidden="true" />
      <p class="state">{stateWord[s.state]}</p>
      <h3 class="title">{s.title}</h3>
      {s.lead && <p class="lead">{s.lead}</p>}
      {s.items && s.items.length > 0 && (
        <ul class="items">
          {s.items.map((item) => (
            <li>
              <svg class="tick" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                {s.state === 'done' ? (
                  <path d="M2.5 6.3 5 8.6l4.5-5.2" />
                ) : (
                  <circle cx="6" cy="6" r="3.2" />
                )}
              </svg>
              {item}
            </li>
          ))}
        </ul>
      )}
      {s.services && s.services.length > 0 && (
        <ul class="services">
          {s.services.map((name) => (
            <li>{name}</li>
          ))}
        </ul>
      )}
      {s.groups && s.groups.length > 0 && (
        <div class="groups">
          {s.groups.map((g) => (
            <div class="group">
              <p class="group-label">{g.label}</p>
              <ul class="items">
                {g.items.map((item) => (
                  <li>
                    <svg class="tick" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                      <path d="M3 6h6" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
      <p class="next">
        <span class="next-label">{t.limitNext}</span>
        <span>{s.next}</span>
      </p>
    </li>
  ))}
</ol>

<style>
  .track {
    --rail-x: 0.5rem;
    --dot: 1rem;
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .stage {
    position: relative;
    padding: 0 0 2.25rem 2.25rem;
  }

  .stage:last-child {
    padding-bottom: 0;
  }

  /* The rail from this stage's marker down to the next one. Solid under a running stage, dashed
     under one that has not run yet. The last stage has no rail below it. */
  .stage:not(:last-child)::before {
    content: '';
    position: absolute;
    top: calc(var(--dot) + 0.375rem);
    bottom: 0.25rem;
    left: calc(var(--rail-x) - 1px);
    border-left: 2px solid var(--accent);
  }

  .stage.open:not(:last-child)::before,
  .stage.planned:not(:last-child)::before {
    border-left: 2px dashed var(--border-strong);
  }

  .marker {
    position: absolute;
    top: 0.15rem;
    left: calc(var(--rail-x) - var(--dot) / 2);
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    box-sizing: border-box;
  }

  /* Running: filled, with a soft ring of light. */
  .done .marker {
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  /* Not yet checked: half lit. */
  .open .marker {
    border: 2px solid var(--accent);
    background: linear-gradient(90deg, var(--accent) 50%, var(--bg) 50%);
  }

  /* Planned: an empty ring. */
  .planned .marker {
    border: 2px solid var(--border-strong);
    background: var(--bg);
  }

  .state {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.3rem;
  }

  .done .state {
    color: var(--accent);
  }

  .title {
    margin-top: 0.125rem;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
  }

  .lead {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .items {
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .items li {
    position: relative;
    padding-left: 1.375rem;
    color: var(--fg);
  }

  .items li + li {
    margin-top: 0.375rem;
  }

  .tick {
    position: absolute;
    top: 0.3em;
    left: 0;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .done .tick {
    stroke: var(--accent);
    stroke-width: 1.8;
  }

  .services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.875rem;
    padding: 0;
    list-style: none;
  }

  .services li {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--fg);
    font-size: var(--text-xs);
  }

  .groups {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  /* Wide: the groups sit side by side, a small plan read left to right. */
  @media (min-width: 48rem) {
    .groups {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .group-label {
    color: var(--muted);
  }

  .group .items {
    margin-top: 0.375rem;
  }

  /* The next step closes each stage, set off by a short rule so it reads as the way forward. */
  .next {
    display: grid;
    gap: 0.125rem;
    margin-top: 1rem;
    padding-left: 0.875rem;
    border-left: 1px solid var(--border-strong);
    color: var(--fg);
  }

  .next-label {
    color: var(--muted);
  }

  @media (min-width: 40rem) {
    .next {
      grid-template-columns: max-content 1fr;
      gap: 1rem;
    }
  }
</style>
