---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/*
 * One screenshot inside the text. With `dark`, a light/dark pair that follows the theme switch;
 * without it, a single image shown in both themes (Rain Alert).
 *
 * placement:
 *   full  - the width of the text column (the default)
 *   aside - a narrow figure for tall images (an app panel): floated right beside the paragraph
 *           that follows it from 40rem, centred above the text on phones. Headings and component
 *           blocks clear it (global.css), so it never runs into the next section.
 */
interface Props {
  /** The screenshot; with `dark`, the light-UI version of a pair. */
  light: ImageMetadata;
  /** The dark-UI version. Without it the single image shows in both themes. */
  dark?: ImageMetadata;
  /** Describes what the screenshot shows. Required, never "screenshot". */
  alt: string;
  caption?: string;
  placement?: 'full' | 'aside';
}

const { light, dark, alt, caption, placement = 'full' } = Astro.props;
const aside = placement === 'aside';
// Never wider than the source: small screenshots are not upscaled.
const widths = (aside ? [320, 480, 640] : [720, 1080, 1440]).filter((w) => w <= light.width);
if (widths.length === 0 || widths[widths.length - 1]! < light.width) widths.push(light.width);
const sizes = aside ? '(min-width: 40rem) 20rem, 22rem' : '(min-width: 64rem) 960px, 100vw';

// Processed by Astro's image pipeline: hashed WebP files under /_astro/, never raw into public/.
async function variants(src: ImageMetadata) {
  const images = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp' })));
  return {
    srcset: images.map((i, n) => `${i.src} ${widths[n]}w`).join(', '),
    fallback: images[Math.min(1, images.length - 1)]!,
  };
}
const l = await variants(light);
const d = dark ? await variants(dark) : undefined;
---

<figure class:list={['not-prose', aside ? 'shot-aside' : 'my-8']}>
  <div class="border-border bg-surface overflow-hidden rounded-lg border">
    {/* With a pair, .only-light / .only-dark hide the inactive one (the header switch decides),
        and a hidden lazy image is never downloaded. */}
    <img
      src={l.fallback.src}
      srcset={l.srcset}
      sizes={sizes}
      alt={alt}
      width={light.width}
      height={light.height}
      loading="lazy"
      decoding="async"
      class:list={['h-auto w-full', d && 'only-light']}
    />
    {d && dark && (
      <img
        src={d.fallback.src}
        srcset={d.srcset}
        sizes={sizes}
        alt={alt}
        width={dark.width}
        height={dark.height}
        loading="lazy"
        decoding="async"
        class="only-dark h-auto w-full"
      />
    )}
  </div>
  {caption && <figcaption class="text-muted mt-2 text-sm">{caption}</figcaption>}
</figure>

<style>
  .shot-aside {
    max-width: 22rem;
    margin: 0.5rem auto 1.75rem;
  }

  @media (min-width: 40rem) {
    .shot-aside {
      float: right;
      width: 20rem;
      margin: 0.375rem 0 1.25rem 2rem;
    }
  }
</style>
