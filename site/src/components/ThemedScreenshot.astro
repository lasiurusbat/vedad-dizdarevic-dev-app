---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** The same screenshot in the light and the dark UI; the browser picks by prefers-color-scheme. */
  light: ImageMetadata;
  dark: ImageMetadata;
  /** Describes what the screenshot shows. Required, never "screenshot". */
  alt: string;
  caption?: string;
}

const { light, dark, alt, caption } = Astro.props;
const widths = [720, 1080, 1440];
const sizes = '(min-width: 64rem) 960px, 100vw';

// Processed by Astro's image pipeline: hashed WebP files under /_astro/, never raw into public/.
async function variants(src: ImageMetadata) {
  const images = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp' })));
  return {
    srcset: images.map((i, n) => `${i.src} ${widths[n]}w`).join(', '),
    fallback: images[1]!,
  };
}
const l = await variants(light);
const d = await variants(dark);
---

<figure class="not-prose my-8">
  <div class="border-border bg-surface overflow-hidden rounded-lg border">
    <picture>
      <source
        media="(prefers-color-scheme: dark)"
        srcset={d.srcset}
        sizes={sizes}
        type="image/webp"
      />
      <img
        src={l.fallback.src}
        srcset={l.srcset}
        sizes={sizes}
        alt={alt}
        width={light.width}
        height={light.height}
        loading="lazy"
        decoding="async"
        class="h-auto w-full"
      />
    </picture>
  </div>
  {caption && <figcaption class="text-muted mt-2 text-sm">{caption}</figcaption>}
</figure>
