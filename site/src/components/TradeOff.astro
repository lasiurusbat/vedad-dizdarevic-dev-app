---
/*
 * A decision's trade-off, directly under the section heading that names the decision, drawn as a
 * reviewed change: what it gained is the added line, what it costs the removed line, one under the
 * other at every width (side by side, the German price text ran far longer than the gain). Each row
 * has a narrow gutter with its + or − sign (CSS, hidden from screen readers), so the side is clear before the label is read. The
 * gained row is "lit" (accent tint, accent gutter edge); the price row sits on the neutral surface.
 * Both texts are body size, because they are the point of the section, not a footnote.
 */
import { getLocale, useTranslations } from '../i18n';

interface Props {
  gained: string;
  price: string;
}

const { gained, price } = Astro.props;
const t = useTranslations(getLocale(Astro.currentLocale));
---

<div class="tradeoff not-prose" role="note" aria-label={t.tradeOff}>
  <dl>
    <div class="row gained">
      <dt>{t.tradeGained}</dt>
      <dd>{gained}</dd>
    </div>
    <div class="row price">
      <dt>{t.tradePrice}</dt>
      <dd>{price}</dd>
    </div>
  </dl>
</div>

<style>
  .tradeoff {
    margin: 0 0 2.25rem;
  }

  dl {
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
  }

  .row + .row {
    border-top: 1px solid var(--border);
  }

  /* The gutter is drawn, not markup: dt and dd must stay direct children of the row. The empty
     alternative text keeps screen readers from announcing the sign. */
  .row::before {
    grid-row: 1 / 3;
    grid-column: 1;
    display: grid;
    justify-items: center;
    align-content: start;
    padding-top: 0.875rem;
    border-right: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.4;
  }

  dt,
  dd {
    grid-column: 2;
    padding-inline: 1.125rem;
  }

  dt {
    padding-top: 0.875rem;
    margin-bottom: 0.25rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  dd {
    padding-bottom: 1rem;
    color: var(--fg);
    font-size: var(--text-body);
    line-height: 1.55;
  }

  /* The added line: accent tint, accent sign and label, an accent edge on the gutter. */
  .gained {
    background: color-mix(in srgb, var(--accent) 11%, transparent);
  }

  .gained::before {
    content: '+';
    content: '+' / '';
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    box-shadow: inset 2px 0 0 var(--accent);
    color: var(--accent);
  }

  .gained dt {
    color: var(--accent);
  }

  /* The removed line: neutral surface, muted sign. */
  .price::before {
    content: '−';
    content: '−' / '';
    background: var(--surface);
    color: var(--muted);
  }
</style>
