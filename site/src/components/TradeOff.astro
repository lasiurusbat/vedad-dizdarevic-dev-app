---
/*
 * A decision's trade-off as a small ledger, directly under the section heading that names the
 * decision: what it gained on the left, what it costs on the right (stacked on phones). The gained
 * side is "lit" like a traced diagram path (accent top edge, faint accent tint); the price side
 * stays neutral. Both texts are body size in the main text colour, because they are the point of
 * the section, not a footnote. The + and - signs say which side is which before the label is read.
 */
import { getLocale, useTranslations } from '../i18n';

interface Props {
  gained: string;
  price: string;
}

const { gained, price } = Astro.props;
const t = useTranslations(getLocale(Astro.currentLocale));
---

<div class="tradeoff not-prose" role="note" aria-label={t.tradeOff}>
  <dl>
    <div class="side gained">
      <dt>
        <span class="sign" aria-hidden="true">
          +
        </span>
        {t.tradeGained}
      </dt>
      <dd>{gained}</dd>
    </div>
    <div class="side price">
      <dt>
        <span class="sign" aria-hidden="true">
          −
        </span>
        {t.tradePrice}
      </dt>
      <dd>{price}</dd>
    </div>
  </dl>
</div>

<style>
  .tradeoff {
    margin: 0 0 2.25rem;
  }

  dl {
    display: grid;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .side {
    padding: 1rem 1.25rem 1.125rem;
    border-top: 2px solid var(--border-strong);
  }

  .gained {
    border-top-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  /* Phones: stacked, a hairline between the two sides. */
  .price {
    border-top: 1px solid var(--border);
  }

  dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .sign {
    display: inline-grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.75rem;
    line-height: 1;
  }

  .gained dt {
    color: var(--fg);
  }

  /* The lit side's sign is filled, the price side's only outlined. */
  .gained .sign {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  dd {
    margin-top: 0.375rem;
    color: var(--fg);
    font-size: var(--text-body);
    line-height: 1.55;
  }

  /* From 40rem the two sides stand side by side, each with its own top edge. */
  @media (min-width: 40rem) {
    dl {
      grid-template-columns: 1fr 1fr;
    }

    .price {
      border-top: 2px solid var(--border-strong);
      border-left: 1px solid var(--border);
    }
  }
</style>
