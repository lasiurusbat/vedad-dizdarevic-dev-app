---
import '../styles/global.css';
import interLatin from '../../node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { alternateUrls, localeUrl, locales, useTranslations, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Set false on pages with no translated twin (the 404 page): no hreflang, switch goes home. */
  translated?: boolean;
  /**
   * Which translations of this page exist (locale -> path), for pages that are not translated
   * one to one (case studies). A missing locale links to that language's home page and gets no
   * hreflang. Default: every locale at the same path.
   */
  alternates?: Partial<Record<Locale, string>>;
}

const { title, description, locale = 'en', translated = true, alternates } = Astro.props;
const t = useTranslations(locale);
const urls: Record<Locale, string> = alternates
  ? { en: alternates.en ?? localeUrl('en'), de: alternates.de ?? localeUrl('de') }
  : translated
    ? alternateUrls(Astro.url.pathname)
    : { en: localeUrl('en'), de: localeUrl('de') };
// Locales that really have this page (for hreflang).
const hreflangLocales = alternates ? locales.filter((l) => alternates[l]) : locales;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? t.role} />
    {translated && [
      ...hreflangLocales.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(urls[l], Astro.site)} />
      )),
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(urls[hreflangLocales[0] ?? 'en'], Astro.site)}
      />,
    ]}
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f101a" media="(prefers-color-scheme: dark)" />
    {/* Saved theme choice, applied before paint; must come after the theme-color tags. */}
    <script is:inline src="/theme.js"></script>
  </head>
  <body class="bg-bg text-fg min-h-screen font-sans antialiased">
    <a
      href="#main"
      class="bg-fg text-bg sr-only rounded-md px-4 py-3 focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      {t.skipToContent}
    </a>
    <Header locale={locale} urls={urls} />
    <main id="main" class="page">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
