---
import { type Locale, localeUrl, useTranslations } from '../i18n';
import CaseIllustration, { type IllustrationVariant } from '../components/CaseIllustration.astro';
import CTAButton from '../components/CTAButton.astro';
import Base from './Base.astro';

interface Props {
  locale: Locale;
  title: string;
  summary: string;
  /** Where translations of this case study live; see Base. */
  alternates?: Partial<Record<Locale, string>>;
  /** Symbolic art beside the title on wide screens; none when unset. */
  illustration?: IllustrationVariant;
}

const { locale, title, summary, alternates, illustration } = Astro.props;
const t = useTranslations(locale);
---

<Base
  title={`${title} | ${t.siteTitle}`}
  description={summary}
  locale={locale}
  alternates={alternates}
>
  <article class="max-w-page px-gutter py-section mx-auto">
    <a
      href={`${localeUrl(locale)}#work`}
      class="inline-flex min-h-11 items-center text-sm underline"
    >
      ← {t.backToWork}
    </a>
    <header class:list={['mt-4', illustration ? 'case-head' : 'max-w-measure']}>
      <div class="max-w-measure">
        <h1 class="text-4xl">{title}</h1>
        <p class="text-muted mt-4 text-xl">{summary}</p>
      </div>
      {illustration && <CaseIllustration variant={illustration} />}
    </header>
    <div class="prose mt-10">
      <slot />
    </div>
  </article>
  {/*
    Every case study ends with a way to act on it: a band across the page, outside the article's
    column, opened by the same faded hairline as the home sections and a soft bloom below it.
    The contact is the primary action; the way back to the other work is secondary.
  */}
  <aside class="closing" aria-labelledby="case-cta-title">
    <div class="max-w-page px-gutter closing-inner mx-auto">
      <p id="case-cta-title" class="font-display closing-text">
        {t.caseCtaText}
      </p>
      <div class="closing-actions">
        <CTAButton href={`${localeUrl(locale)}#contact`}>{t.caseCtaButton}</CTAButton>
        <CTAButton href={`${localeUrl(locale)}#work`} variant="secondary">
          {t.caseCtaMore}
        </CTAButton>
      </div>
    </div>
  </aside>
</Base>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  .closing::before,
  .closing::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .closing::before {
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--divider) 15%,
      var(--divider) 85%,
      transparent
    );
  }

  .closing::after {
    z-index: -1;
    height: 100%;
    background: radial-gradient(ellipse 45% 100% at 50% 0, var(--bloom), transparent 70%);
  }

  .closing-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .closing-text {
    max-width: 22ch;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Wide: the question on the left, the actions on the right, on one baseline. The actions
     never wrap there; the question takes the remaining width (German is longer). */
  @media (min-width: 64rem) {
    .closing-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2.5rem;
    }

    .closing-actions {
      flex: none;
      flex-wrap: nowrap;
    }
  }

  /* The illustration fills the empty right side of the header on wide screens only; on phones
     the evidence should come first, so it is left out. */
  .case-head > :global(.illo) {
    display: none;
  }

  @media (min-width: 64rem) {
    .case-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
      align-items: center;
      gap: 2.5rem;
    }

    /* 20% larger than the first version (its column plus 5rem of right margin, about 32rem):
       about 38rem, reaching 2rem into the gap and the rest into the right margin. Capped at the
       space actually left beside the page (gutter plus the area outside --container-page, minus
       1rem for a scrollbar), so it never causes sideways scrolling on narrower desktops. */
    .case-head > :global(.illo) {
      --room: max(
        var(--spacing-gutter),
        (100vw - var(--container-page)) / 2 + var(--spacing-gutter)
      );
      display: block;
      width: min((100% + 5rem) * 1.2, 100% + 2rem + var(--room) - 1rem);
      margin: -5rem 0 -4rem -2rem;
    }
  }
</style>
