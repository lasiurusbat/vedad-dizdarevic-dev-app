---
import { type Locale, localeUrl, useTranslations } from '../i18n';
import Headers from '../components/illustrations/Headers.astro';
import Inbox from '../components/illustrations/Inbox.astro';
import Umbrella from '../components/illustrations/Umbrella.astro';
import CTAButton from '../components/CTAButton.astro';
import { articleLd } from '../lib/structuredData';
import type { CaseStudy } from '../lib/caseStudies';
import Base from './Base.astro';

type IllustrationId = NonNullable<CaseStudy['data']['illustration']>;

/** One header illustration per id in the case-study schema. */
const illustrations = { inbox: Inbox, umbrella: Umbrella, headers: Headers } satisfies Record<
  IllustrationId,
  unknown
>;

interface Props {
  locale: Locale;
  title: string;
  summary: string;
  /** Picks the page's share image. */
  slug: string;
  /** Where translations of this case study live; see Base. */
  alternates?: Partial<Record<Locale, string>>;
  /** Symbolic art beside the title on wide screens; none when unset. */
  illustration?: IllustrationId;
  /** The case study to read next, linked at the foot of the closing band. */
  next?: { title: string; href: string };
}

const { locale, title, summary, slug, alternates, illustration, next } = Astro.props;
const t = useTranslations(locale);
const Illustration = illustration && illustrations[illustration];
---

<Base
  title={`${title} | ${t.siteTitle}`}
  description={summary}
  locale={locale}
  alternates={alternates}
  caseStudy={slug}
  jsonLd={articleLd(locale, title, summary, Astro.url.pathname, slug)}
>
  <article class="max-w-page px-gutter py-section mx-auto overflow-x-clip">
    <a
      href={`${localeUrl(locale)}#work`}
      class="inline-flex min-h-11 items-center text-sm underline"
    >
      ← {t.backToWork}
    </a>
    <header class:list={['mt-4', illustration ? 'case-head' : 'max-w-measure']}>
      <div class="max-w-measure">
        <h1 class="text-4xl">{title}</h1>
        <p class="text-muted mt-4 text-xl">{summary}</p>
      </div>
      {Illustration && <Illustration />}
    </header>
    <div class="prose mt-10">
      <slot />
    </div>
  </article>
  {/*
    Every case study ends with a way to act on it: a band across the page, outside the article's
    column, opened by the same faded hairline as the home sections and a soft bloom below it.
    The contact is the primary action; the way back to the other work is secondary. Under them,
    past a second hairline, the next case study, so a reader can go on without the home page.
  */}
  <aside class="closing" aria-labelledby="case-cta-title">
    <div class="max-w-page px-gutter closing-inner mx-auto">
      <p id="case-cta-title" class="font-display closing-text">
        {t.caseCtaText}
      </p>
      <div class="closing-actions">
        <CTAButton href={`${localeUrl(locale)}#contact`}>{t.caseCtaButton}</CTAButton>
        <CTAButton href={`${localeUrl(locale)}#work`} variant="secondary">
          {t.caseCtaMore}
        </CTAButton>
      </div>
    </div>
    {next && (
      <div class="max-w-page px-gutter mx-auto">
        <a href={next.href} class="next-case">
          <span class="next-label">{t.caseNext}</span>
          <span class="next-title font-display">
            {next.title}
            <span class="next-arrow" aria-hidden="true">
              →
            </span>
          </span>
        </a>
      </div>
    )}
  </aside>
</Base>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  .closing::before,
  .closing::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .closing::before {
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--divider) 15%,
      var(--divider) 85%,
      transparent
    );
  }

  .closing::after {
    z-index: -1;
    height: 100%;
    background: radial-gradient(ellipse 45% 100% at 50% 0, var(--bloom), transparent 70%);
  }

  .closing-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .closing-text {
    max-width: 22ch;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  /* The next case study: a quiet text link, label above title, opened by a hairline. */
  .next-case {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--divider);
    text-decoration: none;
  }

  .next-label {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .next-title {
    max-width: 40ch;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.25;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 150ms ease;
  }

  .next-case:hover .next-title,
  .next-case:focus-visible .next-title {
    text-decoration-color: currentColor;
  }

  .next-arrow {
    display: inline-block;
    margin-left: 0.35em;
    transition: transform 150ms ease;
  }

  .next-case:hover .next-arrow {
    transform: translateX(0.2em);
  }

  @media (prefers-reduced-motion: reduce) {
    .next-title,
    .next-arrow {
      transition: none;
    }
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Wide: the question on the left, the actions on the right, on one baseline. The actions
     never wrap there; the question takes the remaining width (German is longer). */
  @media (min-width: 64rem) {
    .closing-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2.5rem;
    }

    .closing-actions {
      flex: none;
      flex-wrap: nowrap;
    }
  }

  /* The illustration fills the empty right side of the header on wide screens only; on phones
     the evidence should come first, so it is left out. */
  .case-head > :global(.illo) {
    display: none;
  }

  @media (min-width: 64rem) {
    .case-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
      align-items: center;
      gap: 2.5rem;
    }

    /* 20% larger than the first version (its column plus 5rem of right margin, about 32rem):
       about 38rem, reaching 2rem into the gap and the rest into the right margin. Capped at the
       space actually left beside the page (gutter plus the area outside --container-page, minus
       1rem for a scrollbar), so it never causes sideways scrolling on narrower desktops. */
    .case-head > :global(.illo) {
      --room: max(
        var(--spacing-gutter),
        (100vw - var(--container-page)) / 2 + var(--spacing-gutter)
      );
      display: block;
      width: min((100% + 5rem) * 1.2, 100% + 2rem + var(--room) - 1rem);
      margin: -5rem 0 -4rem -2rem;
    }
  }
</style>
