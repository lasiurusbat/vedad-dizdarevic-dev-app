---
import { en } from '../i18n/en';
import Base from '../layouts/Base.astro';
---

<Base title={`${en.notFoundTitle} | ${en.siteTitle}`}>
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-4 px-6 py-12">
    <h1 class="text-4xl font-bold tracking-tight">{en.notFoundTitle}</h1>
    <p class="text-muted">{en.notFoundText}</p>
    <a href="/" class="text-accent inline-flex min-h-11 items-center underline">
      {en.backHome}
    </a>
  </main>
</Base>
