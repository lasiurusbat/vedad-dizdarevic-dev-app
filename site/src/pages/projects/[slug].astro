---
import { render } from 'astro:content';
import CaseStudySummary from '../../components/CaseStudySummary.astro';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import { getCaseStudies, nextCaseStudy, slugOf, translationsOf } from '../../lib/caseStudies';

export async function getStaticPaths() {
  const entries = await getCaseStudies('en');
  return entries.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const alternates = await translationsOf(slugOf(entry));
const next = await nextCaseStudy('en', slugOf(entry));
---

<CaseStudyLayout
  locale="en"
  title={entry.data.title}
  summary={entry.data.summary}
  alternates={alternates}
  illustration={entry.data.illustration}
  next={next}
>
  <CaseStudySummary locale="en" data={entry.data} />
  <Content costs={entry.data.costs} />
</CaseStudyLayout>
